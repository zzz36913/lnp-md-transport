; PROD: dt=20 fs，C-rescale tau_p=4 ps；-maxh 截断 + -cpi 续跑。J005: nstxout(trr) 写全体系含水帧(默认 50 ns)，xtc 仍只按 NSTXTC
integrator               = md
dt                       = 0.020
nsteps                   = @NSTEPS@
nstxout-compressed       = @NSTXTC@
nstxout                  = @NSTTRR@
nstvout                  = 0
nstfout                  = 0
nstenergy                = 5000
nstlog                   = 25000
cutoff-scheme            = Verlet
nstlist                  = 20
verlet-buffer-tolerance  = 0.005
coulombtype              = reaction-field
rcoulomb                 = 1.1
epsilon_r                = 15
epsilon_rf               = 0
vdw_type                 = cut-off
vdw_modifier             = Potential-shift-verlet
rvdw                     = 1.1
tcoupl                   = v-rescale
tc-grps                  = System
tau_t                    = 1.0
ref_t                    = @TEMP@
pcoupltype               = @PCTYPE@
ref_p                    = @REFP@
compressibility          = @COMP@
constraints              = none
constraint_algorithm     = lincs
lincs_order              = 8
lincs_iter               = 2
pcoupl                   = c-rescale
tau_p                    = 4.0
gen_vel                  = no
continuation             = yes
