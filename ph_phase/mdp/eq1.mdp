; EQ1: 随机混合盒压缩阶段，小 dt=5 fs，各向同性 C-rescale tau_p=2 ps
integrator               = md
dt                       = 0.005
nsteps                   = @NSTEPS@
nstxout-compressed       = 20000
nstenergy                = 1000
nstlog                   = 5000
cutoff-scheme            = Verlet
nstlist                  = 20
verlet-buffer-tolerance  = 0.005
coulombtype              = reaction-field
rcoulomb                 = 1.1
epsilon_r                = 15
epsilon_rf               = 0
vdw_type                 = cut-off
vdw_modifier             = Potential-shift-verlet
rvdw                     = 1.1
tcoupl                   = v-rescale
tc-grps                  = System
tau_t                    = 1.0
ref_t                    = @TEMP@
pcoupltype               = isotropic
ref_p                    = 1.0
compressibility          = 3e-4
constraints              = none
constraint_algorithm     = lincs
lincs_order              = 8
lincs_iter               = 2
pcoupl                   = c-rescale
tau_p                    = 2.0
gen_vel                  = yes
gen_temp                 = @TEMP@
gen_seed                 = @SEED@
