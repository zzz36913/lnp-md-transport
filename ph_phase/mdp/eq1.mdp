; EQ1: 压缩阶段，dt=@DT@ ps(J004 默认 5 fs)，C-rescale tau_p=@TAUP@ ps；随机混合用 isotropic，预组装用 semiisotropic
integrator               = md
dt                       = @DT@
nsteps                   = @NSTEPS@
nstxout-compressed       = 20000
nstenergy                = 1000
nstlog                   = 5000
cutoff-scheme            = Verlet
nstlist                  = 20
verlet-buffer-tolerance  = 0.005
coulombtype              = reaction-field
rcoulomb                 = 1.1
epsilon_r                = 15
epsilon_rf               = 0
vdw_type                 = cut-off
vdw_modifier             = Potential-shift-verlet
rvdw                     = 1.1
tcoupl                   = v-rescale
tc-grps                  = System
tau_t                    = 1.0
ref_t                    = @TEMP@
pcoupltype               = @PCTYPE@
ref_p                    = @REFP@
compressibility          = @COMP@
constraints              = none
constraint_algorithm     = lincs
lincs_order              = 8
lincs_iter               = 2
pcoupl                   = c-rescale
tau_p                    = @TAUP@
gen_vel                  = yes
gen_temp                 = @TEMP@
gen_seed                 = @SEED@
