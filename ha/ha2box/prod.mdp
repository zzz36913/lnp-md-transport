; HA2 水盒 PROD：dt 20 fs，无限制，C-rescale；@NSTEPS@ 默认 500000 = 10 ns（单槽测 ns/day）
integrator               = md
dt                       = 0.020
nsteps                   = @NSTEPS@
nstxout-compressed       = 50000
nstenergy                = 5000
nstlog                   = 5000
cutoff-scheme            = Verlet
nstlist                  = 20
verlet-buffer-tolerance  = 0.005
coulombtype              = reaction-field
rcoulomb                 = 1.1
epsilon_r                = 15
epsilon_rf               = 0
vdw_type                 = cut-off
vdw_modifier             = Potential-shift-verlet
rvdw                     = 1.1
tcoupl                   = v-rescale
tc-grps                  = System
tau_t                    = 1.0
ref_t                    = 310
pcoupl                   = c-rescale
pcoupltype               = isotropic
tau_p                    = 4.0
ref_p                    = 1.0
compressibility          = 3e-4
gen_vel                  = no
continuation             = yes
