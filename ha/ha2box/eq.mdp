; HA2 水盒 EQ：dt 10 fs，骨架位置限制（-DPOSRES，martinize2 -p backbone 写的 POSRES），C-rescale，@NSTEPS@ 由脚本替换（默认 50000 = 0.5 ns）
define                   = -DPOSRES
integrator               = md
dt                       = 0.010
nsteps                   = @NSTEPS@
nstxout-compressed       = 10000
nstenergy                = 1000
nstlog                   = 5000
cutoff-scheme            = Verlet
nstlist                  = 20
verlet-buffer-tolerance  = 0.005
coulombtype              = reaction-field
rcoulomb                 = 1.1
epsilon_r                = 15
epsilon_rf               = 0
vdw_type                 = cut-off
vdw_modifier             = Potential-shift-verlet
rvdw                     = 1.1
tcoupl                   = v-rescale
tc-grps                  = System
tau_t                    = 1.0
ref_t                    = 310
pcoupl                   = c-rescale
pcoupltype               = isotropic
tau_p                    = 4.0
ref_p                    = 1.0
compressibility          = 3e-4
refcoord_scaling         = com
gen_vel                  = yes
gen_temp                 = 310
gen_seed                 = 20261023
