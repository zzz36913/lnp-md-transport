; R2a eq2 (dd/56): 与官方 martini_v3.0_prod.mdp 逐项一致, 仅 dt/nsteps/tau_p(eq)/ref_t/输出/gen_vel 随阶段或设计值改
integrator               = md
dt                       = 0.01
nsteps                   = 200000
nstxout-compressed       = 50000
nstenergy                = 1000
nstlog                   = 5000
cutoff-scheme            = Verlet
nstlist                  = 20
rlist                    = 1.35
verlet-buffer-tolerance  = -1
pbc                      = xyz
coulombtype              = reaction-field
rcoulomb                 = 1.1
epsilon_r                = 15
epsilon_rf               = 0
vdw_type                 = cutoff
vdw-modifier             = Potential-shift-verlet
rvdw                     = 1.1
nsttcouple               = 20
nstpcouple               = 5
tcoupl                   = v-rescale
tc-grps                  = Solvent Rest
tau_t                    = 1.0 1.0
ref_t                    = 320 320
gen_vel                  = no
gen_temp                 = 320
gen_seed                 = 20349439
continuation             = yes
pcoupl                   = c-rescale
pcoupltype               = semiisotropic
tau_p                    = 4
ref_p                    = 1.0 1.0
compressibility          = 3e-4 3e-4
refcoord_scaling         = all
comm-mode                = Linear
nstcomm                  = 100
comm-grps                = Rest Solvent
constraints              = none
constraint_algorithm     = Lincs
lincs_order              = 8
lincs_warnangle          = 90
lincs_iter               = 2
