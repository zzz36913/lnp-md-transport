# run_R4N1x.sh -- R4N1x 追加包 (PRE_REG_AMENDMENT_R4N1_02): 主包 R4N1 (已发, 不改) 某槽主链跑完后接着跑:
#   L 臂 (优先): 长盒 H_II, K1 检验; h050 T320, DOPE/DOPC, Lz 约 22 nm (DOPC 21.93 / DOPE 38.18), n=3 (+ s4 替补), 名字 R4N1_<体系>_h050_T320_hiiL_s<k>
#   C4: 350 K h100, 4 体系 × (hii, lam), n=3, 400 ns, 原 PREREG 判据; 放不下的按 K 12:42 裁剪序 (先内标 MC3H/MC3, 再 lam 臂) 进 supp 队列 (有时间才跑, 否则第 2 晚)
# 由 run_R4N1.sh 复制, 只改 [R4N1x] 处: 等待启动器 (wait_slot, 每槽), ONLY 过滤, 追加包 MPS (x_mps_pick), launch_guard 第 5 节 (主包在跑时的冲突检查改为 "认出主包的、排除它、其余照旧 FAIL").
# 用法:  WAIT_MAIN=auto bash run_R4N1x.sh <k03|k04>    正式: 过 launch_guard 后两槽各自等主包同槽 done 再起 (见 lib_R4N1x.sh "等主槽")
#        START_AT="2026-10-30 21:00 +0800" ...           调度手动接入时间点 (此前不起; 到点后仍要求槽空)
#        touch $OUT/slots/<机>_<A|B>.GO                    调度手动接入 (确认主槽不会再起新条; 再等 GO_QUIET_S 无主包容器即起)
#        ONLY="Larm" / ONLY="DOPC_h050_T320_hiiL,C4hii" / ONLY_FILE=<文件> ...   只跑挑出来的条目 (分段闭环)
#        CHECK=1 / DRY=1 / APPEND_TO=<R4N1x_run_目录> / NEW_RUN=1 同主包
# 判读: C4 用冻结的 verdict_R4_3day.py (与主包合并 inputs, 见 README_R4N1x.md §6); L 臂用 verdict_Larm.py (只 import 冻结函数).
# 不覆写/不 rm; MPS 先认人再 quit, 只 quit 自己的 pipe, 不 kill, 不删目录; 主包的 MPS/容器/目录一概不碰 (只读其日志与 docker ps).
HERE=$(cd "$(dirname "$0")" && pwd); MACHINE=${1:?usage: bash run_R4N1x.sh <k03|k04>}; ORCH_PID=$$
case $MACHINE in k03|k04) ;; *) echo "ABORT: 机器名须为 k03 或 k04"; exit 1;; esac
. "$HERE/lib_R4N1x.sh"
rdlines0(){ grep -vE '^\s*(#|$)' "$1" | awk '{print $1}'; }
REFB=$(rdlines0 $HERE/chains/${MACHINE}_A.txt | head -1)   # 估时参考 build = A 链第一条
REFH=$(cat $HERE/chains/${MACHINE}_[AB].txt | rdlines0 /dev/stdin | grep -E '_hiiL?_' | head -1); REFL=$(cat $HERE/chains/*.txt | rdlines0 /dev/stdin | grep '_lam_' | head -1)   # 闸门自检用 (各臂一条) [R4N1x] 本包主链无 lam (全在 supp), REFL 从全部链/supp/替补文件取
CA=$HERE/chains/${MACHINE}_A.txt; CB=$HERE/chains/${MACHINE}_B.txt; SPARES=$HERE/chains/spares_${MACHINE}.txt; SUPPQ=$HERE/chains/supp_${MACHINE}.txt
rdlines(){ [ -f "$1" ] && grep -vE '^\s*(#|$)' "$1" | awk '{print $1}'; }
# ------------------------------------------------------------------ 发车判据 (R2b REVIEW §4 同款多条件 + R3 专项)
f(){ echo "  [FAIL] $*"; bad=1; }; p(){ echo "  [ok]   $*"; }
launch_guard(){ local b x dup P n2; bad=0
  echo "== launch_guard machine=$MACHINE MODE=$MODE variant=$(cat $HERE/VARIANT 2>/dev/null) $(date '+%F %T %z')"
  [ -n "$(cat $HERE/VARIANT 2>/dev/null)" ] && p "VARIANT=$(cat $HERE/VARIANT)" || f "缺 VARIANT 文件"
  # 1 包完整
  ( cd $HERE && sha256sum -c MANIFEST_sha256.txt --quiet ) >/dev/null 2>&1 && p "MANIFEST sha256 全 OK" || f "包与 MANIFEST_sha256.txt 不符 (cd $HERE && sha256sum -c MANIFEST_sha256.txt)"
  # 2 参数/开关
  [ "$MAXWARN_PROD" = 0 ] && p "MAXWARN_PROD=0" || f "MAXWARN_PROD=$MAXWARN_PROD (须 0; prod 警告须看见, 非 0 需改包)"
  case $RELAX_ARM in
    crescale_dev) [ "$MAXWARN_RELAX" = 0 ] && p "RELAX_ARM=crescale_dev (偏离 SI 协议的开发臂), MAXWARN_RELAX=0" || f "crescale_dev 不需要 maxwarn, MAXWARN_RELAX=$MAXWARN_RELAX 须 0";;
    literal) if [ "$K_APPROVED_LITERAL" = yes ] && [ "$MAXWARN_RELAX" = 2 ]; then p "RELAX_ARM=literal, K_APPROVED_LITERAL=yes, MAXWARN_RELAX=2 (逐字核对 2 条警告; 不符则 HALT)"; else f "literal 须同时 K_APPROVED_LITERAL=yes 且 MAXWARN_RELAX=2 (现 '$K_APPROVED_LITERAL'/$MAXWARN_RELAX)"; fi;;
    *) f "RELAX_ARM=$RELAX_ARM 非法";; esac
  if [ -n "${NSTEPS_OVERRIDE_RELAX}${NSTEPS_OVERRIDE_PROD}" ]; then [ "$MODE" = local ] && p "NSTEPS_OVERRIDE_* 已设 (MODE=local 冒烟)" || f "NSTEPS_OVERRIDE_* 只允许 MODE=local"; else p "无 nsteps 覆盖"; fi
  [ -z "${ALLOW_BUSY:-}" ] && p "未设 ALLOW_BUSY" || f "ALLOW_BUSY 已设 (本包不接受)"
  # 3 时间窗
  if [ "$(rem_s)" -gt 0 ]; then p "距 DEADLINE($DEADLINE) 剩 $(rem_h) h"; else f "已过 DEADLINE"; fi
  # AMENDMENT_01 (REVIEW S2, K 12:14): 完整版硬门槛 = 只允许在 FULL_CUTOFF 前新启动; 之后拒跑, 改用缩减版 (APPEND_TO 续跑同一套 run 不算新启动)
  if [ "$(cat $HERE/VARIANT 2>/dev/null)" = full ] && [ -z "${APPEND_TO:-}" ]; then
    if [ $(date +%s) -lt $(date -d "$FULL_CUTOFF" +%s) ]; then p "完整版: 现在早于 FULL_CUTOFF ($FULL_CUTOFF), 允许新启动"; else f "完整版只允许在 $FULL_CUTOFF 之前新启动; 现在 $(date '+%F %T %z') -> 拒跑, 请改用 R4N1_reduced 包"; fi; fi
  P=$(perf_eff); n2=$(need_h $REFB)
  echo "  [info] 有效速率 ${P} ns/day/槽 (PERF_NOM=$PERF_NOM F_THR=$F_THR; 估计非实测), 一条 $REFB (relax+闸+prod, 珠数缩放, 估算) 约需 ${n2} h; 剩余 $(rem_h) h ->" \
        "$(awk -v r=$(rem_h) -v n=$n2 -v t=$TAIL_H 'BEGIN{ if(r-t>=n) print "主批第 1 波可完整跑满"; else print "第 1 波 prod 会被 -maxh 截断; 用 NSTEPS 更短的包或向 K 报告"}')"
  # AMENDMENT_01 (REVIEW S3): 包与输出都须在 $HOME 下 (gatewrap 容器只挂 $HOME 和 /tmp); MODE=local 冒烟只提示
  for x in "$HERE" "$J"; do case "$(readlink -m "$x")/" in "$(readlink -m "$HOME")"/*) p "在 \$HOME 下: $x";; *) [ "$MODE" = local ] && echo "  [info] MODE=local: $x 不在 \$HOME 下 (仅 box 冒烟允许)" || f "$x 不在 \$HOME ($HOME) 下 (gate 容器只挂 \$HOME 和 /tmp)";; esac; done
  # 4 输入/链
  need_cmd || bad=1
  for b in $(rdlines $CA; rdlines $CB; rdlines $SPARES; rdlines $SUPPQ); do valid_name $b || { f "链/替补/补跑里有非法 build 或缺 expect.env: $b"; continue; }
    for x in start.gro sys.top index.ndx relax_$RELAX_ARM.mdp prod_$(arm_of $b).mdp $(grep -E '^#include' $INP/$b/sys.top 2>/dev/null | sed 's/.*"\(.*\)".*/\1/' | sort -u); do [ -s $INP/$b/$x ] || f "缺 $INP/$b/$x"; done
    [ "$(exp_of $b EXP_ARM)" = "$(arm_of $b)" ] || f "$b expect.env EXP_ARM=$(exp_of $b EXP_ARM) 与名字不符"; [ "T$(exp_of $b EXP_TEMP)" = "$(echo $b | sed -E 's/.*_(T[0-9]+)_.*/\1/')" ] || f "$b expect.env EXP_TEMP 与名字不符"
    [ "$(arm_of $b)" = hii ] && [ -z "$(exp_of $b BOX0)" ] && f "$b 缺 BOX0 (hii L2 闸门要用)"; done
  for b in $HIST_BAN; do (rdlines $CA; rdlines $CB; rdlines $SPARES; rdlines $SUPPQ) | grep -qx "$b" && f "禁用 build 入链: $b"; done
  [ -n "$(rdlines $CA)" ] && [ -n "$(rdlines $CB)" ] && p "chains: A=$(rdlines $CA | wc -l) 条 B=$(rdlines $CB | wc -l) 条 spares=$(rdlines $SPARES | wc -l) 补跑队列=$(rdlines $SUPPQ | wc -l)" || f "缺链文件"
  dup=$( (rdlines $CA; rdlines $CB; rdlines $SPARES; rdlines $SUPPQ) | sort | uniq -d | tr '\n' ' '); [ -z "$dup" ] && p "链/替补/补跑无重复 build" || f "重复 build: $dup"
  dup=$(for x in $HERE/chains/*.txt; do rdlines $x; done | sort | uniq -d | tr '\n' ' '); [ -z "$dup" ] && p "两机全部 chains/spares/supp 文件之间无同一 build 重复 (账本只按机, 跨机重复会被当成 2 个独立重复实验)" || f "跨机重复 build: $dup"
  # [R4N1x] ONLY: 每个 tok 须至少命中本机一条 build (防拼错后静默什么都不跑)
  if [ -n "$ONLY_TOKS" ]; then for x in $ONLY_TOKS; do n2=0; for b in $(rdlines $CA; rdlines $CB; rdlines $SPARES; rdlines $SUPPQ); do for g in $(groups_of $b); do [ "$g" = "$x" ] && n2=$((n2+1)); done; done
      [ $n2 -gt 0 ] && p "ONLY tok '$x' 命中本机 $n2 条" || f "ONLY tok '$x' 不命中本机任何 build (拼错? 本机格: $( (rdlines $CA; rdlines $CB; rdlines $SPARES; rdlines $SUPPQ) | while read b; do cell_of $b; done | sort -u | tr '\n' ' '))"; done
    echo "  [info] ONLY 生效: 本机将跑 $( (rdlines $CA; rdlines $CB; rdlines $SUPPQ) | while read b; do only_ok $b && echo $b; done | wc -l) 条主链/补跑 (+替补按 VOID)"; else p "ONLY 未设: 全跑"; fi
  # [R4N1x] 等主槽参数
  [ -z "$START_AT" ] || { date -d "$START_AT" +%s >/dev/null 2>&1 && p "START_AT=$START_AT 可解析 ($(date -d "$START_AT" '+%F %T %z'))" || f "START_AT='$START_AT' 无法解析"; }
  x=$(main_run); case "$WAIT_MAIN" in none) p "WAIT_MAIN=none: 不依赖主包, 只要求起跑时本槽无 ^R4N1_${MACHINE}_ 主包容器";; auto) [ -n "$x" ] && p "WAIT_MAIN=auto -> 主 run 目录 $x" || f "WAIT_MAIN=auto 但 $JMAIN/R4N1_run_${MACHINE}_* 不是恰好 1 个 (有 $(ls -1d $JMAIN/R4N1_run_${MACHINE}_* 2>/dev/null | wc -l) 个) -> 请显式 WAIT_MAIN=<目录>";;
    *) [ -d "$x/slots" ] && p "WAIT_MAIN=$x (有 slots/)" || f "WAIT_MAIN=$x 不是主 run 目录 (无 slots/)";; esac
  [ -n "$x" ] && for t in A B; do [ -f $x/slots/${MACHINE}_$t.log ] && echo "  [info] 主槽 ${MACHINE}_$t 日志末行: $(tail -1 $x/slots/${MACHINE}_$t.log | cut -c1-160)"; done
  # 5 进程/容器/MPS 冲突 (R2b M1: 60 s 复查; 不抢占)
  # [R4N1x] 主包 R4N1 允许在跑: 它的编排进程 (run_R4N1.sh)、容器 (^R4N1_<机>_)、容器内 gmx、它的 MPS 守护 (pipe 在 $HOME/mps_R4N1/ 下) 被认出并排除;
  #         其余一切照主包规则 FAIL (含: 认不出归属的 gmx、其它 R2a/R2b/R3/R4/j009 容器或脚本、另一个 run_R4N1x、认不出的 MPS 进程). 改动写在 README_R4N1x.md §4, 不是放宽.
  if [ "$MODE" = docker ]; then
    x=$(gmx_unattributed); [ -z "$x" ] && p "gmx 进程: $(pgrep -c gmx) 个, 全部在主包 ^R4N1_${MACHINE}_ 容器内 (认出并排除)" || f "有不属于主包容器的 gmx 进程: $x"
    x=$(procs_other $$ 'R2a_machine|R2a_slot|R2b_machine|R2b_slot|run_R2|run_prerun|preflight_R3|run_R3\.sh|run_R4\.sh|run_R4N1x\.sh'); [ -z "$x" ] && p "无 R2a/R2b/prerun/run_R3/run_R4/其它 run_R4N1x 脚本进程 (已排除本进程及其祖先/后代)" || f "有相关脚本进程: $(echo "$x" | head -3 | tr '\n' ';')"
    x=$(procs_other $$ 'run_R4N1\.sh'); [ -z "$x" ] && echo "  [info] 主包 run_R4N1.sh 编排进程: 无" || echo "  [info] 主包 run_R4N1.sh 编排进程在跑 (允许; 本包等它的槽): $(echo "$x" | head -2 | cut -c1-120 | tr '\n' ';')"
    if [ -n "${HAVE_LOCK:-}" ]; then p "已持有 flock $J/.R4N1x_${MACHINE}.flock"; elif test_lock; then p "flock 可得 (无同机 run_R4N1x 在跑)"; else f "flock 被占用: 同机已有 run_R4N1x 在跑"; fi
    x=$(docker ps --format '{{.Names}}' 2>/dev/null | grep -E '^(R2a_|R2b_|R3|R4_|R4N1x_|j009_)|^R4N1_' | grep -vE "^R4N1_${MACHINE}_[0-9]+_"); [ -z "$x" ] && p "docker ps 无 R2a_/R2b_/R3*/R4_/R4N1x_/j009_ 容器, 也无非本机编号的 R4N1_ 容器" || f "有占卡容器: $(echo "$x" | tr '\n' ' ')"
    echo "  [info] 主包容器 (允许): $(main_any_cn | tr '\n' ' ')"
    # MPS: 主包自己的守护 (pipe 在 $HOME/mps_R4N1/) 认出并排除; 其余 MPS 进程 = 残留, 先认人再 quit, 这里只认人, FAIL
    x=$(mps_unattributed); [ -z "$x" ] && p "nvidia-cuda-mps 进程: $(ps -eo args= | grep -c '[n]vidia-cuda-mps') 个, 全部认作主包 R4N1 的 (pipe 在 $HOME/mps_R4N1/)" || f "认不出归属的 MPS 进程 (先认人再 quit; 不 kill): $(echo "$x" | tr '\n' ';') -> bash $HERE/tools/mps_residue.sh; 别人的 -> 报 K/调度"
    [ "$X_MPS" = off ] && p "X_MPS=off: 本包全程不用 MPS" || p "X_MPS=auto: 主编排在时不用 MPS; 主编排退出且机上无 MPS 进程时起自己的全新 \$HOME/mps_R4N1x/${MACHINE}_<TS>"
    if [ $bad = 0 ]; then echo "  ... ${GUARD_RECHECK_S:-60}s 后复查 (R2b M1: 空档漏报)"; sleep ${GUARD_RECHECK_S:-60}; x=$(gmx_unattributed); [ -z "$x" ] && p "60 s 后仍无主包容器外的 gmx" || f "60 s 后出现主包容器外的 gmx: $x"; fi
    x=$(df -Pk "$(dirname $J)" 2>/dev/null | awk 'NR==2{printf "%d",$4/1048576}'); [ "${x:-0}" -ge 10 ] && p "磁盘可用 ${x} GiB" || f "磁盘可用 ${x:-?} GiB < 10 (AMENDMENT_01: SEL_KEEP_FRAMES=1 不删帧, 门槛 5->10)"
  else echo "  [info] MODE=local: 跳过 gmx/容器/MPS/磁盘冲突检查 (仅 box 冒烟)"; fi
  # 5b [TRR-AMEND] 取起点规则自检: 参数 + 容器内 trjconv 经 stdin (-i) 取组号能跑通 (用 start.gro 当 1 帧 "轨迹")
  if [ "$SEL_RULE" = 1 ]; then [ "$GATE_MODE" = host ] && p "SEL_RULE=1 取起点规则: relax 每 ${SEL_NSTOUT} 步写 trr, 末 ${SEL_WIN_PS} ps 逐帧闸门, 选最后合格帧 (SEL_KEEP_FRAMES=$SEL_KEEP_FRAMES)" || echo "  [warn] SEL_RULE=1 但 GATE_MODE=$GATE_MODE: 无自动逐帧闸门, 回退旧行为 (末帧+-t cpt)"
    case "$SEL_NSTOUT$SEL_WIN_PS" in *[!0-9]*|"") f "SEL_NSTOUT/SEL_WIN_PS 须为整数";; esac
  else echo "  [warn] SEL_RULE=0: 旧行为 (relax 末帧 + -t relax.cpt), 与已作废的预跑 0/6 读数同款起点, 不建议"; fi
  # 6 gmx 版本 + 闸门可执行 (真跑一次 builder 级闸门, 期望 PASS)
  GMXV=$(gmx_version); [ -n "$GMXV" ] && check_gmxv && p "gmx 版本 $GMXV" || f "gmx 版本检查失败 ('$GMXV', 期望 ${EXPECT_GMX:-2026.3})"
  if [ "$GATE_MODE" = host ]; then
    $GATE_PY -c 'import numpy, scipy, MDAnalysis' >/dev/null 2>&1 && p "闸门依赖 numpy/scipy/MDAnalysis 可导入 ($GATE_PY)" || f "GATE_PY=$GATE_PY 导不进 numpy/scipy/MDAnalysis (设 GATE_PY=<含依赖的 python>, 或 GATE_MODE=manual)"
    x=$(mktemp -d)
    if [ -n "$REFH" ]; then ( cd $x && $GATE_PY $HERE/gate/t0_gate_hii.py $INP/$REFH/start.gro --level relax --box0 $(exp_of $REFH BOX0) --expect-lipids $(exp_of $REFH EXP_LIP) --expect-w $(exp_of $REFH EXP_W) --json gh.json ) >/dev/null 2>&1 && p "H_II 闸门自检: $REFH/start.gro L2 PASS (rc=0)" || f "H_II 闸门自检失败 (应 PASS): $REFH"; fi
    if [ -n "$REFL" ]; then ( cd $x && $GATE_PY $HERE/gate/t0_gate_launch.py $INP/$REFL/start.gro --level builder --arm lam --expect-lipids $(exp_of $REFL EXP_LIP) --expect-w $(exp_of $REFL EXP_W) --json g.json ) >/dev/null 2>&1 && p "片层闸门自检: $REFL/start.gro PASS (rc=0)" || f "片层闸门自检失败 (应 PASS): $REFL"
      [ -n "$REFH" ] && { ( cd $x && $GATE_PY $HERE/gate/t0_gate_hii.py $INP/$REFL/start.gro --level relax --box0 $(exp_of $REFL BOX0) --expect-lipids $(exp_of $REFL EXP_LIP) --expect-w $(exp_of $REFL EXP_W) --json nh.json ) >/dev/null 2>&1; [ $? = 3 ] && p "H_II 闸门负自检: 片层起点判不合格 rc=3" || f "H_II 闸门负自检: 片层起点未得 rc=3"; }; fi
    ( cd $x && $GATE_PY $HERE/gate/t0_gate_launch.py $HERE/proof/neg_selftest_bridged.gro --level builder --arm lam --expect-lipids 960 --expect-w 720 --json h.json ) >/dev/null 2>&1 && f "闸门负自检: 已知桥连帧竟 PASS" || p "闸门负自检: 已知桥连帧 (R3 DOPC relax 末帧) 判不合格 rc!=0"
  else p "GATE_MODE=manual: 须有人在 $OUT/manual_gate/<build>.PASS|.VOID 放闸门结论 (每条 relax 后最长等 ${GATE_WAIT_MAX_H} h)"; fi
  if [ "$SEL_RULE" = 1 ]; then x=$OUT/seltest_$$; mkdir -p $x; ( cd $x && echo 0 | GXI=1 CN=$(cn_name seltest_$BASHPID) gx trjconv -f $INP/$REFB/start.gro -s $INP/$REFB/start.gro -sep -o t.gro ) > $x/trjconv.log 2>&1
    [ -n "$(ls $x/t*.gro 2>/dev/null)" ] && p "trjconv(stdin 组号) 自检通过" || f "trjconv 自检失败 (docker run -i / gmx trjconv?): $x/trjconv.log"; fi
  # 5c 两槽同时 grompp 自检 (真发车时两槽的第 1 条 build 会同时 grompp relax; 这里用各槽首条 build 同时跑, 验容器名不撞/2026.3 能 grompp 派生 mdp; 只写 $OUT/gpchk, 不 mdrun)
  y=$OUT/gpchk; mkdir -p $y; gpp=; for t in "chkA $(rdlines $CA | head -1)" "chkB $(rdlines $CB | head -1)"; do set -- $t
    ( SLOT_TAG=$1; b=$2; dd=$y/$1/$b/attempt_001; mkdir -p $dd; mdp=$dd/relax_$RELAX_ARM.mdp
      if [ "$SEL_RULE" = 1 ]; then awk '!($1=="nstxout"||$1=="nstvout")' $INP/$b/relax_$RELAX_ARM.mdp > $mdp; printf 'nstxout = %s\nnstvout = %s\n' $SEL_NSTOUT $SEL_NSTOUT >> $mdp; else cp $INP/$b/relax_$RELAX_ARM.mdp $mdp; fi
      gp $dd relax $mdp $INP/$b/start.gro $INP/$b/sys.top $INP/$b/index.ndx $MAXWARN_RELAX; echo "$GP_RC $GP_NW" > $dd/gp_rc_nw.txt ) & gpp="$gpp $!"; done; wait $gpp
  for t in chkA chkB; do r=$(cat $y/$t/*/attempt_001/gp_rc_nw.txt 2>/dev/null); if [ "$RELAX_ARM" = crescale_dev ]; then [ "$r" = "0 0" ] && p "两槽同时 grompp 自检 $t: rc=0 无 warning" || f "两槽同时 grompp 自检 $t 失败 (rc nwarn='$r'): $y/$t/*/attempt_001/grompp.log"
    else [ "${r%% *}" = 0 ] && p "两槽同时 grompp 自检 $t: rc=0 (literal, nwarn=${r#* })" || f "两槽同时 grompp 自检 $t 失败 ('$r'): $y/$t/*/attempt_001/grompp.log"; fi; done
  [ $bad = 0 ] && { echo "== launch_guard: ALL OK"; return 0; } || { echo "== launch_guard: FAIL (见 [FAIL])"; return 1; }; }
# ------------------------------------------------------------------ 补跑队列 (主批 10 条后空槽接活; 严格按下列优先级, 每个作业须过时间判断)
# 优先级: (1) L2 替补轮: 本机账本里有 VOID_L2 (或 relax 失败, 见 REPLACE_ON_RELAX_FAIL) 的格, 取 spares_<机>.txt 里同格未用的替补 build, 再 relax+gate+prod
#         (2) chains/supp_<机>.txt 按文件顺序 (R4N1: 见 README_R4N1.md).
# 时间判断 supp_fits: 剩余墙钟 >= need_h + SUPP_MARGIN_H(0.75=45min) 且 now+need_h < DEADLINE; 不过则记 SUPP_SKIP_NO_TIME 并看下一个候选 (更短的作业可能放得下).
supp_fits(){ local b=$1 n; n=$(need_h $b); SUPP_NEED=$n
  awk -v r=$(rem_h) -v n=$n -v m=$SUPP_MARGIN_H 'BEGIN{exit !(r>=n+m)}' && [ $(( $(date +%s) + $(awk -v n=$n 'BEGIN{printf "%d", n*3600}') )) -lt $DL ]; }
claim_supp(){ local cell v s line b; CLAIM_B=; CLAIM_ROLE=; CLAIM_NOTE=; halted && return 1
  for cell in $(for b in $(rdlines $CA; rdlines $CB; rdlines $SPARES); do cell_of $b; done | sort -u); do
    for v in $(ledger_list void); do [ "$(cell_of $v)" = "$cell" ] || continue; ledger_has replfor $v && continue
      for s in $(rdlines $SPARES); do [ "$(cell_of $s)" = "$cell" ] || continue; ledger_has claim $s && continue
        supp_fits $s || { ledger_claim skipnote ${SLOT_TAG}.$s && rec skip $s repl - - SUPP_SKIP_NO_TIME - - - - - - $SUPP_NEED "替补(for $v) 剩余不足 need+${SUPP_MARGIN_H}h"; continue; }
        ledger_claim replfor $v || continue; ledger_claim claim $s || { rmdir $OUT/ledger/replfor/$v; continue; }
        CLAIM_B=$s; CLAIM_ROLE=replacement; CLAIM_NOTE="replaces=$v"; return 0; done
      [ -n "$(for s in $(rdlines $SPARES); do [ "$(cell_of $s)" = "$cell" ] && echo $s; done)" ] || { ledger_claim noted nospare_$v && { rec skip $v repl - - NO_SPARE - - - - - - - "格 $cell 无替补 build -> 该格 n<3, 按 PREREG_R4_3day 记 NOT_EVALUABLE"; say "NO_SPARE: $v 无替补"; }; }
    done; done
  for b in $(rdlines $SUPPQ); do ledger_has claim $b && continue; only_ok $b || { ledger_claim skipnote only.$b && rec skip $b supp - - SKIP_NOT_ONLY - - - - - - - "ONLY=$ONLY_TOKS"; continue; }   # [R4N1x]
    supp_fits $b || { ledger_claim skipnote ${SLOT_TAG}.$b && rec skip $b supp - - SUPP_SKIP_NO_TIME - - - - - - $SUPP_NEED "补跑剩余不足 need+${SUPP_MARGIN_H}h"; continue; }
    ledger_claim claim $b || continue; CLAIM_B=$b; CLAIM_ROLE=supplement; CLAIM_NOTE="queue=$(basename $SUPPQ)"; return 0; done
  return 1; }
slot(){ local tag=$1 po=$2 ch=$3 b
  SLOT_TAG=$tag; say "== slot start chain=$ch pinoffset=$po NT=$NT deadline=$DEADLINE gate=$GATE_MODE relax=$RELAX_ARM"
  wait_slot ${tag#${MACHINE}_} || { say "== slot end (未起: 等待放弃)"; return 0; }   # [R4N1x]
  for b in $(rdlines $ch); do only_ok $b || { ledger_claim skipnote only.$b && rec skip $b primary - - SKIP_NOT_ONLY - - - - - - - "ONLY=$ONLY_TOKS"; continue; }
    ledger_claim claim $b || { say "$b 已被领取过 (APPEND_TO 续跑: run_build 自身幂等, 继续)"; }; x_mps_pick; say "MPS for $b: $X_MPS_NOTE"; run_build $b primary $po main; say "END $b rc=$? mps=$X_MPS_NOTE"; done
  if [ "$SUPP" = 1 ]; then while claim_supp; do x_mps_pick; say "补跑领取 $CLAIM_B ($CLAIM_ROLE $CLAIM_NOTE) need=${SUPP_NEED}h remaining=$(rem_h)h mps=$X_MPS_NOTE"; run_build $CLAIM_B $CLAIM_ROLE $po supp "$CLAIM_NOTE mps=$X_MPS_NOTE"; say "END $CLAIM_B rc=$?"; done; fi
  say "== slot end"; }
summary(){ echo "== summary $MACHINE $(date '+%F %T %z')"; printf 'build\trelax\tgate\tprod\n'
  for d in $OUT/builds/*/; do b=$(basename $d); printf '%s\t%s\t%s\t%s\n' $b $(last_state $d/relax) $(last_state $d/gate) $(last_state $d/prod); done | tee $OUT/SUMMARY.tsv
  for c in $(for b in $(rdlines $CA; rdlines $CB; rdlines $SPARES); do cell_of $b; done | sort -u); do v=$(for x in $(ledger_list void); do [ "$(cell_of $x)" = "$c" ] && echo $x; done | wc -l); g=$(for x in $OUT/builds/*/gate; do [ -d $x ] && [ "$(cell_of $(basename $(dirname $x)))" = "$c" ] && echo $x; done | wc -l); echo "L2 void_rate $c(本机): $v / $g 个已读闸 (L1 见 inputs/L1_summary.tsv)"; done | tee -a $OUT/SUMMARY.tsv
  for v in $(ledger_list void); do ledger_has replfor $v || echo "UNRESOLVED_VOID $v (无替补/时间不足 -> 该格 n 减少, 判读按 PREREG_R4_3day NOT_EVALUABLE/n<3 处理)"; done | tee -a $OUT/SUMMARY.tsv; }
# ------------------------------------------------------------------ main
if [ -n "${CHECK:-}" ]; then OUT=/tmp/R4N1x_check_$$; mkdir -p $OUT/slots; OUT_PARENT=$OUT; launch_guard; exit $?; fi
if [ -n "${DRY:-}" ]; then
  OUT=$(mktemp -d /tmp/R4N1x_dry_XXXXXX); OUT_PARENT=$OUT; mkdir -p $OUT/slots $OUT/ledger; SLOT_TAG=dry; GMXV=dry
  echo "== DRY machine=$MACHINE MODE=$MODE relax=$RELAX_ARM maxwarn(relax/prod)=$MAXWARN_RELAX/$MAXWARN_PROD deadline=$DEADLINE remaining=$(rem_h)h P=$(perf_eff) ns/day (PERF_NOM=$PERF_NOM F_THR=$F_THR) 不建输出/不起 MPS/容器"
  for t in "A $PINA $CA" "B $PINB $CB"; do set -- $t; t0=$(date +%s); echo "-- slot ${MACHINE}_$1 pin=$2 (顺序执行)"
    for b in $(rdlines $3); do n=$(need_h $b); st=$(date -d @$t0 '+%m-%d %H:%M'); t0=$((t0+$(awk -v n=$n 'BEGIN{printf "%d", n*3600}'))); echo "   $b need=${n}h  预计 $st -> $(date -d @$t0 '+%m-%d %H:%M')  $(awk -v t=$t0 -v d=$DL 'BEGIN{print (t+0>d+0)?"[超 deadline: 会被 -maxh 截断/SKIP]":""}')"
      echo "      [TRR-AMEND] SEL_RULE=$SEL_RULE ($(arm_of $b)): relax 加 nstxout=nstvout=$SEL_NSTOUT -> 末 ${SEL_WIN_PS}ps trr 帧逐帧闸门 -> 选最后合格帧作 prod -c (无 -t); 0 合格 -> VOID_L2"; echo "      relax: grompp -f relax_$RELAX_ARM.mdp -c start.gro -maxwarn $MAXWARN_RELAX; mdrun | gate($GATE_MODE) | prod: $( [ "$SEL_RULE" = 1 ] && echo "grompp -f prod_$(arm_of $b).mdp -c selected.gro (无 -t; 起点 sha 须与闸门判过的一致, 否则 VOID_SEL_MISMATCH; SEL_SKIP 时回退 -c relax.gro -t relax.cpt)" || echo "grompp -f prod_$(arm_of $b).mdp -c relax.gro -t relax.cpt" ) -maxwarn $MAXWARN_PROD; mdrun -maxh=(剩余-${TAIL_H}h)"; done; done
  echo "-- [R4N1x] 实际起点不是 '现在': 每槽等主包同槽 done (WAIT_MAIN=$WAIT_MAIN main_run=$(main_run) START_AT=${START_AT:-无}); 上面时刻按 '现在' 起算, 只看相对长度; 估计结束见 PLAN_ESTIMATE.json"
  echo "-- [R4N1x] ONLY=${ONLY_TOKS:-无(全跑)}: $(for b in $(rdlines $CA; rdlines $CB; rdlines $SUPPQ); do only_ok $b || echo -n "$b(跳过) "; done)"
  echo "-- 补跑队列 (SUPP=$SUPP; 各作业此刻的时间判断; 实际领取发生在槽主链结束时, 此处按 '现在' 评估):"
  for b in $(rdlines $SPARES) $(rdlines $SUPPQ); do supp_fits $b && r=FITS || r=SKIP_NO_TIME; echo "   $b need=${SUPP_NEED}h rem=$(rem_h)h margin=${SUPP_MARGIN_H}h -> $r"; done
  echo "   (优先级: 1 L2 替补[spares: $(rdlines $SPARES | tr '\n' ' ')] -> 2/3 supp 队列顺序 [$(rdlines $SUPPQ | tr '\n' ' ')])"
  exit 0; fi
need_cmd || exit 1
take_lock || { echo "ABORT: 同机 run_R4N1x 已在运行 (flock $J/.R4N1x_${MACHINE}.flock)"; exit 1; }; HAVE_LOCK=1
init_out $MACHINE || exit 1; exec > >(tee -a $OUT/orchestrator.log) 2>&1
echo "OUT=$OUT"; launch_guard || { echo "ABORT: 发车判据不过, 未起 MPS/容器"; exit 1; }
GMXV=${GMXV:-unknown}
{ echo "machine=$MACHINE host=$(hostname) start=$(date '+%F %T %z') deadline=$DEADLINE gmx=$GMXV mode=$MODE"; env | grep -E '^(ONLY|ONLY_FILE|WAIT_|START_AT|GO_QUIET|JMAIN|X_MPS|RELAX_ARM|MAXWARN_|K_APPROVED|F_THR|PERF_NOM|GATE_|SUPP|REPLACE_|SEL_|NT=|PINA|PINB|TAIL_H|MINRUN_H|IMG=|J=|EXPECT_GMX|PRIO|PERF_)' | sort; echo "PRIO=$PRIO NICE=$NICE CPUSH=$CPUSH"; echo "ONLY_TOKS=$ONLY_TOKS"; (cd $HERE && sha256sum run_R4N1x.sh lib_R4N1x.sh MANIFEST_sha256.txt verdict_R4_3day.py verdict_Larm.py PREREG_R4_3day.md PRE_REG_AMENDMENT_R4N1_02.md VARIANT); } > $OUT/RUN_META.txt
# [R4N1x] 不在这里起 MPS (主包可能仍在跑); 每条 build 前 x_mps_pick 决定, 见 lib_R4N1x.sh
cleanup(){ echo "[$(date '+%F %T')] INTERRUPT/EXIT: 只停本脚本容器 ${CN_PREFIX}${MACHINE}_${ORCH_PID}_*"; [ "$MODE" = local ] || { for c in $(docker ps --format '{{.Names}}' | grep "^${CN_PREFIX}${MACHINE}_${ORCH_PID}_"); do docker stop -t 120 $c >/dev/null 2>&1; done; }; }
trap 'cleanup; kill $PA $PB 2>/dev/null; wait $PA $PB 2>/dev/null; x_mps_stop; exit 143' INT TERM
( slot ${MACHINE}_A $PINA $CA ) & PA=$!
( slot ${MACHINE}_B $PINB $CB ) & PB=$!
wait $PA $PB; x_mps_stop; summary; echo "== machine $MACHINE done $(date '+%F %T %z') OUT=$OUT"
␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀R4N2/verdict_Larm.py␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀0000644␀0000000␀0000000␀00000024173␀15271232653␀011433␀ 0␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀ustar  ␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀#!/usr/bin/env python3
"""verdict_Larm.py -- R4N1x L 臂 (长盒 H_II, K1 检验) 判读; 判据 = PRE_REG_AMENDMENT_R4N1_02.md §3 (看数据前写定).
只 import 冻结的 verdict_R4_3day.py (sha 见 FROZEN_sha256.txt) 的函数, 不改它: 单 run 判定 judge_hii_run / 格 hii_cell / 替补选择 select_cell / 读序列 read_series,
常量 (判定窗末 100 ns, RETAIN>=0.80, LOST<=0.20, >=400 ns, >=99 帧, n=3) 全部来自冻结文件. 唯一的运行时改动: collect 时把冻结模块的 NAME 正则
换成多认一个臂 hiiL 的版本 (只影响本进程内的名字解析; hiiL 按 hii 判). 本脚本不判 C4 (C4 用冻结 verdict 原样判).
C4 (350 K h100) 用冻结 verdict 原样判: collect 冻结脚本按其 NAME 自动跳过 hiiL; 要与主包一起出 C1-C4 总判, 先用 merge_status_x.py 合并两边 runs_status.tsv.
用法:
  python3 verdict_Larm.py collect <R4N1x_run_k03_...> <R4N1x_run_k04_...> --inputs <追加包>/inputs --out <OUTL>
  python3 verdict_Larm.py judge <OUTL> --short-status <主包 verdict collect 输出>/runs_status.tsv --short-inputs <主包>/inputs [--horizons 400,max]
输出 <OUTL>/VERDICT_Larm.json / .md. 读法 (预写, §3): 比较时长 H_cmp = 两个 DOPC 格 (长盒 hiiL 与短盒 C1 hii) 所用 run 的观测时长最小值 (须 >= 400 ns), 两边都截到 H_cmp 判.
  长盒 DOPC LOST>=2/3 且 短盒 DOPC LOST<2/3 -> SHORT_BOX_ARTIFACT: 短盒 (Lz0 < 2π r_water0) H_II 臂的 RETAIN 读数降级 (见 §3.3), 不改任何 RULER 判定、不放宽."""
import argparse, csv, hashlib, json, math, os, re, sys
from concurrent.futures import ThreadPoolExecutor
HERE = os.path.dirname(os.path.abspath(__file__)); sys.path.insert(0, HERE)
import verdict_R4_3day as V   # 冻结
NAME_L = re.compile(r'^R4N1_(DOPE|DOPC|MC3H|MC3)_(h\d{3})_(T\d{3})_(hii|hiiL|lam)_s(\d+)$')
LCELLS = {'DOPE': 'DOPE_h050_T320', 'DOPC': 'DOPC_h050_T320'}
def sha(p): return V.sha256(p)

def collect(a):
    V.NAME = NAME_L
    l1 = {}
    for ln in open(os.path.join(a.inputs, 'L1_summary.tsv')).read().splitlines()[1:]:
        p = ln.split('\t'); l1[p[0]] = p[2]
    builds = sorted(b for b in l1 if NAME_L.match(b) and NAME_L.match(b).group(4) == 'hiiL'); os.makedirs(a.out, exist_ok=True)
    roots = [os.path.abspath(r) for r in a.runs]
    with ThreadPoolExecutor(a.jobs) as ex: recs = list(ex.map(lambda b: V.collect_one(b, roots, a.inputs, a.out, l1), builds))
    p = os.path.join(a.out, 'runs_status_Larm.tsv')
    with open(p + '.tmp', 'w') as f:
        f.write('\t'.join(V.STATUS_COLS) + '\n')
        for r in recs: f.write('\t'.join(str(r.get(c, '-')) if r.get(c, '') != '' else '-' for c in V.STATUS_COLS) + '\n')
    os.replace(p + '.tmp', p); print('wrote', p, len(recs), 'builds')

def geom(inputs, b):
    t = open(os.path.join(inputs, b, 'SYSTEM.txt')).read(); g = json.loads(re.search(r'geom=(\{.*?\})', t).group(1)); return g

def as_hii(st):
    st = dict(st); st['arm'] = 'hii' if st['arm'] in ('hii', 'hiiL') else st['arm']; return st

def cell_runs(rows, prim, w, T, arm, horizon):
    sel = [r for r in rows if r['prim'] == prim and r['w'] == w and r['T'] == T and r['arm'] == arm]
    return [V.judge_run(as_hii(r), horizon) for r in sorted(sel, key=lambda r: int(r['seed']))]

def t_obs(runs):
    used, _ = V.select_cell(runs); ev = [r for r in used if r['status'] in V.EVAL_HII]
    return min(r['T_obs_ns'] for r in ev) if len(ev) >= V.N_PER else None

def reading(L, S):
    """预写读法 (AMENDMENT_02 §3.2). L/S = hii_cell(...) 结果 (同一 H_cmp)."""
    if L['state'] != 'EVALUABLE' or S['state'] != 'EVALUABLE': return 'NOT_EVALUABLE', '长盒或短盒 DOPC 格不可评估 (n<3 或未跑), 不下读法'
    lL = L['n_LOST'] >= 2; lS = S['n_LOST'] >= 2
    if lL and not lS: return 'SHORT_BOX_ARTIFACT', '长盒 DOPC LOST>=2/3 而短盒没有 -> 短盒有盒长伪影 (K1 成立): 短盒 (Lz0<2π r_water0) H_II 臂 RETAIN 降级'
    if lL and lS: return 'CONSISTENT_LOST', '长短盒 DOPC 都 LOST>=2/3: 未见盒长伪影'
    if lS and not lL: return 'LONG_BOX_RETAINS_MORE', '短盒 LOST>=2/3 而长盒没有: 与 K1 方向相反, 只报告, 预注册未写对此的降级/升级'
    if L['n_RETAIN'] >= 2 and S['n_RETAIN'] >= 2: return 'CONSISTENT_RETAIN', '长短盒 DOPC 都 RETAIN>=2/3: 在 h050、Lz0 约 22 nm、H_cmp 内未见盒长效应 (K1 在此范围未得到支持; 不排除更长波长/更慢过程, 不覆盖 h100)'
    return 'MIXED', '长短盒都不满足 LOST>=2/3, 且不同时 RETAIN>=2/3: 不下读法'

def judge(a):
    L = list(csv.DictReader(open(os.path.join(a.out, 'runs_status_Larm.tsv')), delimiter='\t'))
    S = list(csv.DictReader(open(a.short_status), delimiter='\t'))
    res = dict(script='verdict_Larm.py', script_sha256=sha(os.path.abspath(__file__)), frozen_verdict_sha256=sha(V.__file__), prereg='PRE_REG_AMENDMENT_R4N1_02.md §3',
               constants=dict(N_PER=V.N_PER, WIN_NS=V.WIN_NS, WIN_MIN_FRAMES=V.WIN_MIN_FRAMES, T_EVAL_MIN_NS=V.T_EVAL_MIN_NS, RETAIN_MIN=V.RETAIN_MIN, LOST_MAX=V.LOST_MAX), by_horizon={})
    # 比较时长 H_cmp (两 DOPC 格所用 run 最短观测时长)
    hl = t_obs(cell_runs(L, 'DOPC', 'h050', 'T320', 'hiiL', None)); hs = t_obs(cell_runs(S, 'DOPC', 'h050', 'T320', 'hii', None))
    H = None if hl is None or hs is None else math.floor(min(hl, hs) + 1e-6)
    res['H_cmp_ns'] = H
    hz = [None if x.strip() == 'max' else float(x) for x in a.horizons.split(',')]
    if H is not None and H >= V.T_EVAL_MIN_NS and H not in hz: hz.append(float(H))
    for h in hz:
        k = 'max' if h is None else '%g' % h; out = {}
        for p in ('DOPE', 'DOPC'):
            cl = V.hii_cell(cell_runs(L, p, 'h050', 'T320', 'hiiL', h)); cs = V.hii_cell(cell_runs(S, p, 'h050', 'T320', 'hii', h))
            out[p] = dict(long=cl, short=cs)
        r, why = reading(out['DOPC']['long'], out['DOPC']['short'])
        dl = out['DOPE']['long']
        pos = 'NOT_EVALUABLE' if dl['state'] != 'EVALUABLE' else ('POS_OK' if dl['n_RETAIN'] >= 2 else 'POS_FAIL')
        lr = 'NOT_EVALUABLE' if 'NOT_EVALUABLE' in (pos,) or out['DOPC']['long']['state'] != 'EVALUABLE' else (
            'PASS' if pos == 'POS_OK' and out['DOPC']['long']['n_RETAIN'] == 0 and out['DOPC']['long']['n_LOST'] >= 2 else 'FAIL')
        res['by_horizon'][k] = dict(cells=out, DOPC_reading=r, DOPC_reading_why=why, DOPE_long_positive=pos, long_ruler_rule12=lr)
    dec = res['by_horizon'].get('%g' % H) if H is not None and H >= V.T_EVAL_MIN_NS else None
    res['decisive'] = dict(horizon=None if dec is None else H, DOPC_reading=dec['DOPC_reading'] if dec else 'NOT_EVALUABLE',
                           note='决定性读法只看 H_cmp; 其它时长只描述' if dec else 'H_cmp 不存在或 < 400 ns -> NOT_EVALUABLE')
    # 降级范围 (§3.3): 短盒 = Lz0 < 2π r_water0 的 hii 构型 (从 SYSTEM.txt 读)
    if a.short_inputs:
        sc = {}
        for r in S:
            if r['arm'] != 'hii': continue
            c = '%s_%s_%s' % (r['prim'], r['w'], r['T'])
            if c in sc: continue
            try: g = geom(a.short_inputs, r['build']); sc[c] = dict(Lz0=g['Lz'], r_water0=g['r_water'], ratio=round(g['Lz'] / (2 * math.pi * g['r_water']), 3))
            except Exception as e: sc[c] = dict(error=str(e)[:80])
        res['short_box_scope'] = {c: dict(v, short=v.get('ratio', 9) < 1) for c, v in sorted(sc.items())}
        res['downgraded_if_artifact'] = sorted(c for c, v in res['short_box_scope'].items() if v.get('short'))
        res['not_covered_by_Larm'] = sorted(c for c, v in res['short_box_scope'].items() if v.get('short') and c.split('_')[1] != 'h050')   # [REVIEW v3] L 臂只在 h050 做; 其它水合的短盒 H_II RETAIN 不因 CONSISTENT_* 而"放行" (AMENDMENT_02 §3.3)
    json.dump(res, open(os.path.join(a.out, 'VERDICT_Larm.json'), 'w'), indent=1, ensure_ascii=False)
    M = ['# VERDICT L 臂 (verdict_Larm.py %s; 冻结 verdict %s)' % (res['script_sha256'][:16], res['frozen_verdict_sha256'][:16]), '',
         '比较时长 H_cmp = %s ns (两 DOPC 格所用 run 最短观测时长; 须 >= 400)' % H, '']
    for k, v in res['by_horizon'].items():
        M.append('## 时长 %s%s' % (k, ' (决定性)' if dec is v else ' (描述)'))
        for p in ('DOPE', 'DOPC'):
            for side in ('long', 'short'):
                c = v['cells'][p][side]; M.append('- %s %s: %s n=%d RETAIN %d / LOST %d / PARTIAL %d  %s' % (p, '长盒 hiiL' if side == 'long' else '短盒 C1 hii', c['state'], c['n_eval'], c['n_RETAIN'], c['n_LOST'], c['n_PARTIAL'], ','.join(c['runs'])))
        M += ['- DOPC 读法: %s — %s' % (v['DOPC_reading'], v['DOPC_reading_why']), '- DOPE 长盒阳性对照: %s' % v['DOPE_long_positive'], '- 长盒尺子 (规则 1+2, 仅描述, 不替代 C1 RULER): %s' % v['long_ruler_rule12'], '']
    M.append('## 决定性读法: %s' % res['decisive']['DOPC_reading'])
    if res['decisive']['DOPC_reading'] == 'SHORT_BOX_ARTIFACT':
        if res['by_horizon']['%g' % H]['DOPE_long_positive'] == 'POS_FAIL': M.append('- 注意: 长盒下阳性对照 DOPE 也不保持 (POS_FAIL), 长盒读出本身可疑 (AMENDMENT_02 §3.2)')
        M.append('- 按 AMENDMENT_02 §3.3: 下列短盒 (Lz0<2π r_water0) H_II 臂 RETAIN 降级为 "可能受盒长伪影抑制", 不作 H_II 偏好证据; 各条件 RULER 判定原样保留, 不放宽、不 FAIL->PASS: ' + ', '.join(res.get('downgraded_if_artifact', ['(未给 --short-inputs)'])))
    if res.get('not_covered_by_Larm'): M.append('- 覆盖范围 (AMENDMENT_02 §3.3): L 臂只检验 h050; 下列短盒 H_II 格未被 L 臂检验, 其 RETAIN 读数无论 L 臂读法如何都标注 "盒长未检验": ' + ', '.join(res['not_covered_by_Larm']))
    open(os.path.join(a.out, 'VERDICT_Larm.md'), 'w').write('\n'.join(M) + '\n'); print('\n'.join(M))

if __name__ == '__main__':
    ap = argparse.ArgumentParser(); sp = ap.add_subparsers(dest='cmd', required=True)
    c = sp.add_parser('collect'); c.add_argument('runs', nargs='+'); c.add_argument('--inputs', required=True); c.add_argument('--out', required=True); c.add_argument('--jobs', type=int, default=4)
    j = sp.add_parser('judge'); j.add_argument('out'); j.add_argument('--short-status', required=True); j.add_argument('--short-inputs'); j.add_argument('--horizons', default='400,max')
    a = ap.parse_args(); collect(a) if a.cmd == 'collect' else judge(a)
␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀R4N2/verdict_R4_3day.py␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀0000644␀0000000␀0000000␀00000066607␀15271232653␀011755␀ 0␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀ustar  ␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀#!/usr/bin/env python3
"""verdict_R4_3day.py -- R4 三晚 (R4N1/N2/N3) 判读脚本. 判据全部来自 PREREG_R4_3day.md (§3-§5, §7), 阈值写死在下方常量;
本文件与 PREREG 的 sha256 写在 MANIFEST/FROZEN_sha256.txt, 改了审查会看见. 零算力 (只读 xtc/STATUS, 只写 --out 目录).

用法:
  python3 verdict_R4_3day.py collect <R4N1_run_目录>... --inputs <N1/inputs> --out <结果目录> [--jobs 4]
      逐 build 汇总起点/prod 状态 (STATUS 文件), 核对 prod 回传文件的 SHA256_out.txt, 对 prod xtc (多 attempt 按序拼接) 跑 gate/series_R4N1.py.
      幂等: series 已存在且源 xtc (路径+大小+mtime) 未变则跳过. 写 <out>/runs_status.tsv, <out>/series/<b>.csv, <out>/series/<b>.src.json
  python3 verdict_R4_3day.py judge <结果目录> --d1v2-lam <D1v2 results_xtc_prereg/runs.tsv> [--compare <旧 VERDICT.json>] [--horizons 400,max]
      -> <out>/runs.tsv cells.tsv VERDICT.json VERDICT.md

冻结规则摘要 (逐条对应 PREREG):
  §3 H_II 臂逐帧: HII = wpol==1 且 n_tube>=1; LAM = wpol==2; NET = wpol==3; DISC = wpol==0; 其余 (wpol==1 且 n_tube==0) = OTHER (非 HII).
  §3 H_II 臂逐条: 判定窗 = 该 run 最后 100 ns (1 ns/帧, 101 帧); RETAIN f_HII>=0.80; LOST f_HII<=0.20 (子类 = 窗内非 HII 帧多数类;
      多数类为 LAM 时还要求窗内 LAM 帧 C_max 中位数 >=0.6 才记 LAM_RETURN, 否则 LAM_LOWC, 仍算 LOST); 其余 PARTIAL.
      t_loss = 5 ns 步长扫描, 第一个 [t0, t0+20 ns] 全为非 HII 帧的 t0 (描述量). n_tube 终值 (描述量).
  §3 片层臂: 主事件 = wpol==1 且 Cz<=0.5 持续 >=20 ns (R3/D1v2 sustained 函数逐字); 次级 = ncl==1 持续 >=5 ns (描述/确认, 不进门).
  §4 起点: VOID_BUILD (L1) / VOID_L2 / RELAX_FAIL 记起点级 VOID -> 同格替补 (s4) 按序顶上; 替补只顶 VOID, 不顶其它失败.
      可评估 n<3 -> 该体系x起点 NOT_EVALUABLE (写明 n); 尺子体系 NOT_EVALUABLE -> 条件 RULER_NOT_EVALUABLE.
  prod NUMERIC_FAIL / GROMPP_FAIL = 不可评估 (不顶); prod VOID_SEL_MISMATCH (起点与闸门判过的帧不一致) = 起点级 VOID (lib 同样记 ledger void).
  评估资格 (建包时、看数据前定): H_II 臂 run 须 prod 观测 >= 400 ns 且判定窗帧数 >= 99, 否则 TRUNC/WINDOW_INCOMPLETE = 不可评估, 不用替补顶;
      片层臂同 D1v2: 有事件即 EVENT (截断前发生也算), 无事件须观测 >= 400 ns 否则 TRUNC (不可评估). xtc sha 与 SHA256_out.txt 不符 = SHA_MISMATCH 不可评估.
  §5 RULER(c): 1 DOPE_hii RETAIN>=2/3; 2 DOPC_hii RETAIN==0/3 且 LOST>=2/3 (命门); 3 DOPC_lam 主事件 0/3 (否则 F3 驱动过强, 条件无效).
      320 K 片层臂复用 D1v2 (--d1v2-lam): 同体系同水合档, D1v2 runs.tsv 里状态为 EVENT/NO_EVENT 的 run 计入; 该体系无此类 run = 起点级 VOID (D1v2: MC3 10/10 VOID_L2).
  §5 相类 (每体系, 每条件; 只在 RULER=PASS 的条件下用于结论): LAM_PREF / HII_PREF / HYST / NEITHER / MIXED (定义见 phase_class); 任一臂 NOT_EVALUABLE -> NOT_EVALUABLE.
  §5 Δ = n_RETAIN(MC3_hii) - n_RETAIN(MC3H_hii): >=+2 SEP_EXPECTED, <=-2 SEP_REVERSE, 其余 NO_SEP; 只在 RULER=PASS 且两格都可评估时判.
  §5 主条件: 优先级 C1 > C3 > C2 > C4 中第一个 PASS.
  §5/§7 F4 时间稳健性: 每个 horizon (默认 400 ns 与各 run 最长时长) 都判一遍; 较短 horizon PASS 而最长 horizon 不 PASS -> 明文 "撤回";
      --compare 给旧 VERDICT.json 时, 旧的 PASS 现在不再 PASS 也明文 "撤回". 最终结论只用最长时长.
  §7 F1 命门失败: 所有已跑 (可评估) 条件规则 2 都 FAIL -> F1; 按 K 10-30 11:30 决定走 B1 (350 K 续到 2 µs). F2: 所有已跑条件 DOPE_hii LOST>=2/3.
"""
import argparse, csv, glob, hashlib, json, os, re, subprocess, sys
from concurrent.futures import ThreadPoolExecutor
HERE = os.path.dirname(os.path.abspath(__file__))
# ---------------- 预注册常量 (PREREG_R4_3day.md) ----------------
N_PER = 3
WIN_NS = 100.0                 # 判定窗: 最后 100 ns
WIN_MIN_FRAMES = 99            # 窗内帧数下限 (101 帧, 允许续跑接缝丢 2 帧) [建包时定]
T_EVAL_MIN_NS = 400.0          # 可评估的最短 prod 观测时长
RETAIN_MIN, LOST_MAX = 0.80, 0.20
LAM_RETURN_CMAX = 0.6
TLOSS_RUN_NS, TLOSS_STEP_NS = 20.0, 5.0
CZ_MAX, EVENT_PERSIST_NS = 0.5, 20.0     # 片层主事件 (D1v2 同)
MERGE_PERSIST_NS = 5.0                   # 片层次级 ncl==1
DOPE_RETAIN_MIN = 2            # 规则 1
DOPC_RETAIN_MAX, DOPC_LOST_MIN = 0, 2    # 规则 2
DOPC_LAM_EVENTS_MAX = 0        # 规则 3
DELTA_SEP = 2
PRIMS = ['DOPE', 'DOPC', 'MC3H', 'MC3']
CONDS = {'C1': ('T320', 'h050'), 'C3': ('T320', 'h100'), 'C2': ('T350', 'h050'), 'C4': ('T350', 'h100')}
PRIORITY = ['C1', 'C3', 'C2', 'C4']
PRIMARY_SEEDS, SPARE_SEEDS = (1, 2, 3), (4,)
START_VOID = ('VOID_BUILD', 'VOID_L2', 'RELAX_FAIL', 'VOID_SEL_MISMATCH')   # lib 记 ledger void 的起点级失败 -> 替补
NAME = re.compile(r'^R4N1_(DOPE|DOPC|MC3H|MC3)_(h\d{3})_(T\d{3})_(hii|lam)_s(\d+)$')

def sustained(t, m, persist):   # R3/D1v2 冻结函数, 逐字
    n = len(t); k = 0
    while k < n:
        if not m[k]: k += 1; continue
        j = k
        while j + 1 < n and m[j + 1]: j += 1
        if t[j] - t[k] >= persist - 1e-9 and (j > k or persist <= 0): return float(t[k])
        k = j + 1
    return None

def frame_cls(wpol, n_tube):
    if wpol == 1 and n_tube >= 1: return 'HII'
    return {2: 'LAM', 3: 'NET', 0: 'DISC'}.get(wpol, 'OTHER')

def read_series(path, horizon=None):
    R = list(csv.DictReader(open(path)))
    rows = []
    for x in R:
        rows.append(dict(t=float(x['t_ns']), ncl=int(float(x['ncl'])), wind=int(float(x['wind'])), wpol=int(float(x['wpol'])),
                         n_tube=int(float(x['n_tube'])), Cz=float(x['Cz']), C_max=float(x['C_max'])))
    rows.sort(key=lambda r: r['t'])
    if rows:
        t0 = rows[0]['t']
        for r in rows: r['t'] -= t0
    if horizon is not None: rows = [r for r in rows if r['t'] <= horizon + 1e-6]
    return rows

def judge_hii_run(rows):
    """-> dict(status, f_HII, sub, t_loss, n_tube_final, ...). status in RETAIN/LOST/PARTIAL/TRUNC/WINDOW_INCOMPLETE/NO_FRAMES"""
    if not rows: return dict(status='NO_FRAMES', T_obs_ns=0.0)
    T = rows[-1]['t']; out = dict(T_obs_ns=round(T, 3), n_frames=len(rows))
    cls = [frame_cls(r['wpol'], r['n_tube']) for r in rows]; t = [r['t'] for r in rows]
    # t_loss (描述; 不依赖判定窗)
    tl = None; t0 = 0.0
    while t0 + TLOSS_RUN_NS <= T + 1e-6:
        idx = [i for i in range(len(t)) if t0 - 1e-6 <= t[i] <= t0 + TLOSS_RUN_NS + 1e-6]
        if idx and t[idx[-1]] - t[idx[0]] >= TLOSS_RUN_NS - 1e-6 and all(cls[i] != 'HII' for i in idx): tl = t0; break
        t0 += TLOSS_STEP_NS
    out.update(t_loss_ns=tl, n_tube_final=rows[-1]['n_tube'], cls_final=cls[-1], n_tube_t0=rows[0]['n_tube'])
    if T < T_EVAL_MIN_NS - 1e-6: out['status'] = 'TRUNC'; return out
    w = [i for i in range(len(t)) if t[i] >= T - WIN_NS - 1e-6]; out['n_window'] = len(w)
    if len(w) < WIN_MIN_FRAMES: out['status'] = 'WINDOW_INCOMPLETE'; return out
    wc = [cls[i] for i in w]; f = sum(c == 'HII' for c in wc) / len(wc); out['f_HII'] = round(f, 4)
    cnt = {k: wc.count(k) for k in ('HII', 'LAM', 'NET', 'DISC', 'OTHER')}; out['window_counts'] = cnt
    if f >= RETAIN_MIN - 1e-12: out['status'] = 'RETAIN'
    elif f <= LOST_MAX + 1e-12:
        out['status'] = 'LOST'; non = {k: v for k, v in cnt.items() if k != 'HII'}
        maj = sorted(non, key=lambda k: (-non[k], ['LAM', 'NET', 'DISC', 'OTHER'].index(k)))[0]
        if maj == 'LAM':
            cm = sorted(rows[i]['C_max'] for i in w if cls[i] == 'LAM'); med = cm[len(cm) // 2] if len(cm) % 2 else 0.5 * (cm[len(cm) // 2 - 1] + cm[len(cm) // 2])
            out['C_max_med_LAM'] = round(med, 4); out['sub'] = 'LAM_RETURN' if med >= LAM_RETURN_CMAX else 'LAM_LOWC'
        else: out['sub'] = maj
    else: out['status'] = 'PARTIAL'
    return out

def judge_lam_run(rows):
    if not rows: return dict(status='NO_FRAMES', T_obs_ns=0.0)
    t = [r['t'] for r in rows]; T = t[-1]; Cz = [r['Cz'] for r in rows]
    deg = all(c < 1e-3 for c in Cz)
    ev = sustained(t, [(r['wpol'] == 1) and (r['Cz'] <= CZ_MAX) and not deg for r in rows], EVENT_PERSIST_NS)
    mg = sustained(t, [r['ncl'] == 1 for r in rows], MERGE_PERSIST_NS)
    out = dict(T_obs_ns=round(T, 3), n_frames=len(rows), t_event_ns=ev, t_merge_ns=mg, cz_degenerate=deg, wpol_final=rows[-1]['wpol'])
    if deg: out['status'] = 'CZ_DEGENERATE'
    elif ev is not None: out['status'] = 'EVENT'
    elif T >= T_EVAL_MIN_NS - 1e-6: out['status'] = 'NO_EVENT'
    else: out['status'] = 'TRUNC'
    return out

EVAL_HII = ('RETAIN', 'LOST', 'PARTIAL'); EVAL_LAM = ('EVENT', 'NO_EVENT')

# ---------------------------------------------------------------- collect
def last_state(d):
    a = sorted(glob.glob(os.path.join(d, 'attempt_[0-9][0-9][0-9]')))
    if not a: return 'NONE', []
    sts = []
    for x in a:
        s = os.path.join(x, 'STATUS'); sts.append((x, open(s).read().split()[0] if os.path.exists(s) and open(s).read().split() else 'NOSTATUS'))
    return sts[-1][1], sts

def sha256(p, bs=1 << 20):
    h = hashlib.sha256()
    with open(p, 'rb') as f:
        for b in iter(lambda: f.read(bs), b''): h.update(b)
    return h.hexdigest()

def collect_one(b, roots, inputs, out, l1):
    m = NAME.match(b); rec = dict(build=b, prim=m.group(1), w=m.group(2), T=m.group(3), arm=m.group(4), seed=int(m.group(5)), roots='', note='')
    if l1.get(b, 'VOID_BUILD') != 'PASS': rec.update(start='VOID_BUILD', prod='NONE', series='-'); return rec
    bds = [os.path.join(r, 'builds', b) for r in roots if os.path.isdir(os.path.join(r, 'builds', b))]
    if not bds: rec.update(start='NOT_RUN', prod='NONE', series='-'); return rec
    rec['roots'] = ';'.join(bds)
    gate = 'NONE'; relax = 'NONE'; prods = []
    for bd in bds:
        g, _ = last_state(os.path.join(bd, 'gate')); r, _ = last_state(os.path.join(bd, 'relax')); _, ps = last_state(os.path.join(bd, 'prod'))
        if g != 'NONE': gate = g
        if r != 'NONE': relax = r
        prods += ps
    if gate == 'PASS': start = 'PASS'
    elif gate == 'VOID_L2': start = 'VOID_L2'
    elif gate in ('GATE_TIMEOUT', 'GATE_ERROR'): start = gate
    elif relax == 'RELAX_FAIL': start = 'RELAX_FAIL'
    elif relax in ('DONE',): start = 'GATE_NONE'
    else: start = 'RELAX_' + relax
    rec['start'] = start
    states = [s for _, s in prods]; rec['prod'] = 'DONE' if 'DONE' in states else (states[-1] if states else 'NONE'); rec['prod_attempts'] = ','.join(states)
    xtcs = []; shabad = []
    for d, _ in prods:
        xs = sorted(glob.glob(os.path.join(d, 'prod*.xtc'))); xtcs += xs
        sf = os.path.join(d, 'SHA256_out.txt'); ref = {}
        if os.path.exists(sf):
            for ln in open(sf):
                p = ln.split()
                if len(p) == 2: ref[p[1].lstrip('*')] = p[0]
        for x in xs:
            r = ref.get(os.path.basename(x))
            if r is None: shabad.append(os.path.basename(x) + ':NO_REF')
            elif sha256(x) != r: shabad.append(os.path.basename(x) + ':MISMATCH')
    if 'VOID_SEL_MISMATCH' in states and 'DONE' not in states: rec['start'] = start = 'VOID_SEL_MISMATCH'
    rec['xtc'] = ';'.join(xtcs); rec['sha_check'] = 'OK' if xtcs and not shabad else ('NO_XTC' if not xtcs else ','.join(shabad))
    if start != 'PASS' or not xtcs: rec['series'] = '-'; return rec
    sd = os.path.join(out, 'series'); os.makedirs(sd, exist_ok=True); cs = os.path.join(sd, b + '.csv'); sj = cs[:-4] + '.src.json'
    src = [[x, os.path.getsize(x), int(os.path.getmtime(x))] for x in xtcs]
    if not (os.path.exists(cs) and os.path.exists(sj) and json.load(open(sj)).get('src') == src):
        top = os.path.join(inputs, b, 'start.gro')
        p = subprocess.run([sys.executable, os.path.join(HERE, 'gate', 'series_R4N1.py'), top] + xtcs + ['--out', cs, '--no-v1'], capture_output=True, text=True)
        if p.returncode != 0: rec['series'] = '-'; rec['note'] = 'SERIES_ERROR: ' + p.stderr.strip().splitlines()[-1][:200] if p.stderr.strip() else 'SERIES_ERROR'; return rec
        json.dump(dict(src=src, top=top), open(sj + '.tmp', 'w')); os.replace(sj + '.tmp', sj)
    rec['series'] = cs; return rec

STATUS_COLS = ['build', 'prim', 'w', 'T', 'arm', 'seed', 'start', 'prod', 'prod_attempts', 'sha_check', 'series', 'xtc', 'roots', 'note']
def collect(a):
    l1 = {}
    for ln in open(os.path.join(a.inputs, 'L1_summary.tsv')).read().splitlines()[1:]:
        p = ln.split('\t'); l1[p[0]] = p[2]
    builds = sorted(b for b in l1 if NAME.match(b)); os.makedirs(a.out, exist_ok=True)
    roots = [os.path.abspath(r) for r in a.runs]
    with ThreadPoolExecutor(a.jobs) as ex: recs = list(ex.map(lambda b: collect_one(b, roots, a.inputs, a.out, l1), builds))
    p = os.path.join(a.out, 'runs_status.tsv')
    with open(p + '.tmp', 'w') as f:
        f.write('\t'.join(STATUS_COLS) + '\n')
        for r in recs: f.write('\t'.join(str(r.get(c, '-')) if r.get(c, '') != '' else '-' for c in STATUS_COLS) + '\n')
    os.replace(p + '.tmp', p); print('wrote', p, len(recs), 'builds')

# ---------------------------------------------------------------- judge
def judge_run(st, horizon):
    """st: runs_status 行 -> 判定 dict (含 eval 标志)"""
    r = dict(build=st['build'], prim=st['prim'], w=st['w'], T=st['T'], arm=st['arm'], seed=int(st['seed']), start=st['start'], prod=st['prod'])
    if st['start'] in START_VOID: r['status'] = st['start']; r['void'] = True; return r
    r['void'] = False
    if st['start'] == 'NOT_RUN': r['status'] = 'NOT_RUN'; return r
    if st['start'] != 'PASS': r['status'] = 'START_' + st['start']; return r
    if st['prod'] in ('NUMERIC_FAIL', 'GROMPP_FAIL'): r['status'] = 'PROD_' + st['prod']; return r
    if st.get('sha_check', 'OK') != 'OK': r['status'] = 'SHA_MISMATCH' if st.get('sha_check') != 'NO_XTC' else 'NO_PROD'; r['sha_check'] = st.get('sha_check'); return r
    if st['series'] in ('-', '') or not os.path.exists(st['series']): r['status'] = 'NO_PROD'; return r
    rows = read_series(st['series'], horizon)
    r.update(judge_hii_run(rows) if st['arm'] == 'hii' else judge_lam_run(rows)); return r

def select_cell(runs):
    """runs: 同格全部 run (按 seed). 主种子 s1-s3, VOID 由替补按序顶上. -> (used, notes)"""
    by = {r['seed']: r for r in runs}; used = []; notes = []
    spares = [by[s] for s in SPARE_SEEDS if s in by]
    for s in PRIMARY_SEEDS:
        r = by.get(s)
        if r is None: notes.append('s%d 缺' % s); continue
        if r.get('void'):
            rep = None
            while spares:
                c = spares.pop(0)
                if c.get('void'): notes.append('替补 s%d 也 %s' % (c['seed'], c['status'])); continue
                rep = c; break
            if rep is None: notes.append('s%d %s 无可用替补' % (s, r['status'])); continue
            notes.append('s%d %s -> 替补 s%d' % (s, r['status'], rep['seed'])); used.append(rep)
        else: used.append(r)
    for c in spares:
        if not c.get('void') and c['status'] not in ('NOT_RUN',): notes.append('替补 s%d 已跑但未被需要, 不计入' % c['seed'])
    return used, notes

def hii_cell(runs):
    used, notes = select_cell(runs); ev = [r for r in used if r['status'] in EVAL_HII]
    c = dict(n_eval=len(ev), n_RETAIN=sum(r['status'] == 'RETAIN' for r in ev), n_LOST=sum(r['status'] == 'LOST' for r in ev),
             n_PARTIAL=sum(r['status'] == 'PARTIAL' for r in ev), LOST_sub=[r.get('sub') for r in ev if r['status'] == 'LOST'],
             runs=['%s:%s' % (r['build'], r['status']) for r in used], notes=notes,
             n_void=sum(1 for r in runs if r.get('void')), n_total=len(runs))
    if not runs or all(r['status'] == 'NOT_RUN' for r in runs): c['state'] = 'NOT_RUN'
    elif all(r.get('void') for r in runs if r['status'] != 'NOT_RUN') and not ev: c['state'] = 'VOID'
    elif len(ev) >= N_PER: c['state'] = 'EVALUABLE'
    else: c['state'] = 'NOT_EVALUABLE'
    return c

def lam_cell_from_runs(runs):
    used, notes = select_cell(runs); ev = [r for r in used if r['status'] in EVAL_LAM]
    c = dict(n_eval=len(ev), n_event=sum(r['status'] == 'EVENT' for r in ev), n_merge=sum(r.get('t_merge_ns') is not None for r in ev),
             runs=['%s:%s' % (r['build'], r['status']) for r in used], notes=notes, source='R4N1', n_void=sum(1 for r in runs if r.get('void')), n_total=len(runs))
    if not runs or all(r['status'] == 'NOT_RUN' for r in runs): c['state'] = 'NOT_RUN'
    elif all(r.get('void') for r in runs if r['status'] != 'NOT_RUN') and not ev: c['state'] = 'VOID'
    elif len(ev) >= N_PER: c['state'] = 'EVALUABLE'
    else: c['state'] = 'NOT_EVALUABLE'
    return c

def lam_cell_d1v2(rows, prim, w):
    sel = sorted([r for r in rows if r['prim'] == prim and r['w'] == w], key=lambda r: int(r['seed'])); ev = [r for r in sel if r['status'] in EVAL_LAM][:N_PER]
    c = dict(n_eval=len(ev), n_event=sum(r['status'] == 'EVENT' for r in ev), n_merge=sum(r.get('t_merge', 'None') not in ('None', '', '-') for r in ev),
             runs=['%s:%s' % (r['build'], r['status']) for r in sel], notes=['320 K 片层臂复用 D1v2 (results_xtc_prereg/runs.tsv)'], source='D1v2')
    c['state'] = 'VOID' if not sel else ('EVALUABLE' if len(ev) >= N_PER else 'NOT_EVALUABLE')
    if not sel: c['notes'].append('D1v2 该体系无可评估 run (D1v2: 中性 MC3 10/10 VOID_L2) -> 起点级 VOID')
    return c

def rule(cell, fn):
    if cell is None or cell['state'] != 'EVALUABLE': return 'NOT_EVALUABLE'
    return 'PASS' if fn(cell) else 'FAIL'

def phase_class(h, l):
    if h is None or l is None or h['state'] in ('NOT_EVALUABLE', 'NOT_RUN') or l['state'] in ('NOT_EVALUABLE', 'NOT_RUN'): return 'NOT_EVALUABLE'
    hv, lv = h['state'] == 'VOID', l['state'] == 'VOID'
    if hv and lv: return 'NOT_EVALUABLE'   # PRE_REG_AMENDMENT_R4N1_01 (M1): 两臂都 VOID -> NOT_EVALUABLE (PREREG §5 L99 / §9.7 取更严读法); 说明见 MC3_note
    Hk = (not hv) and h['n_RETAIN'] >= 2; Hl = (not hv) and h['n_LOST'] >= 2
    Lk = (not lv) and (l['n_eval'] - l['n_event']) >= 2; Le = (not lv) and l['n_event'] >= 2
    if Lk and Hl: return 'LAM_PREF'
    if Hk and Le: return 'HII_PREF'
    if Hk and Lk: return 'HYST'
    if (Hl or hv) and (Le or lv): return 'NEITHER'   # 单臂 VOID + 另一臂 LOST 仍记 NEITHER (§5)
    return 'MIXED'

def judge_condition(cid, runs, d1v2):
    T, w = CONDS[cid]; res = dict(T=T, w=w, systems={})
    any_run = False
    for p in PRIMS:
        hr = [r for r in runs if r['prim'] == p and r['w'] == w and r['T'] == T and r['arm'] == 'hii']
        h = hii_cell(hr) if hr else None
        if T == 'T320': l = lam_cell_d1v2(d1v2, p, w)
        else:
            lr = [r for r in runs if r['prim'] == p and r['w'] == w and r['T'] == T and r['arm'] == 'lam']; l = lam_cell_from_runs(lr) if lr else None
        if h and h['state'] != 'NOT_RUN': any_run = True
        res['systems'][p] = dict(hii=h, lam=l, phase_class=phase_class(h, l))
    if not any_run: res['ruler'] = 'NOT_RUN'; return res
    S = res['systems']
    r1 = rule(S['DOPE']['hii'], lambda c: c['n_RETAIN'] >= DOPE_RETAIN_MIN)
    r2 = rule(S['DOPC']['hii'], lambda c: c['n_RETAIN'] <= DOPC_RETAIN_MAX and c['n_LOST'] >= DOPC_LOST_MIN)
    r3 = rule(S['DOPC']['lam'], lambda c: c['n_event'] <= DOPC_LAM_EVENTS_MAX)
    res['rules'] = {'1_DOPE_pos': r1, '2_DOPC_neg_crux': r2, '3_DOPC_lam_conserve': r3}
    # n<3 时已可确定的失败 (只作说明, 不改标签)
    det = []
    c = S['DOPC']['hii']
    if r2 == 'NOT_EVALUABLE' and c and c['n_RETAIN'] >= 1: det.append('规则2: 可评估的 DOPC_hii 中已有 RETAIN, n 补足也不会过')
    c = S['DOPC']['lam']
    if r3 == 'NOT_EVALUABLE' and c and c.get('n_event', 0) >= 1: det.append('规则3: DOPC_lam 已出现事件 (F3)')
    res['determined_fail_notes'] = det
    rs = [r1, r2, r3]
    res['ruler'] = 'RULER_NOT_EVALUABLE' if 'NOT_EVALUABLE' in rs else ('PASS' if all(x == 'PASS' for x in rs) else 'FAIL')
    res['F3_overdriven'] = (r3 == 'FAIL') or any('F3' in d for d in det)
    for p in ('MC3H', 'MC3'):
        pc = S[p]['phase_class']; S[p]['like'] = [q for q in ('DOPE', 'DOPC') if pc != 'NOT_EVALUABLE' and S[q]['phase_class'] == pc]
    if S['MC3']['hii'] and S['MC3']['hii']['state'] == 'VOID' and S['MC3']['lam'] and S['MC3']['lam']['state'] == 'VOID':
        res['MC3_note'] = '中性 MC3 在本协议下片层与 H_II 起点都无法维持 (起点级), 描述性结果, 不进门; 内标对比 NOT_EVALUABLE'
    a, b = S['MC3']['hii'], S['MC3H']['hii']
    if res['ruler'] != 'PASS': res['delta'] = dict(verdict='NOT_JUDGED', reason='RULER=%s' % res['ruler'])
    elif not (a and b and a['state'] == 'EVALUABLE' and b['state'] == 'EVALUABLE'): res['delta'] = dict(verdict='NOT_EVALUABLE', n_MC3=a and a['n_eval'], n_MC3H=b and b['n_eval'])
    else:
        d = a['n_RETAIN'] - b['n_RETAIN']; res['delta'] = dict(value=d, verdict='SEP_EXPECTED' if d >= DELTA_SEP else ('SEP_REVERSE' if d <= -DELTA_SEP else 'NO_SEP'))
    res['crux_DOPC_hii'] = dict(rule2=r2, n_RETAIN=S['DOPC']['hii']['n_RETAIN'] if S['DOPC']['hii'] else None)
    return res

def judge_all(status_rows, d1v2, horizon):
    runs = [judge_run(st, horizon) for st in status_rows]
    conds = {cid: judge_condition(cid, runs, d1v2) for cid in PRIORITY}
    main = next((c for c in PRIORITY if conds[c]['ruler'] == 'PASS'), None)
    ran = [c for c in PRIORITY if conds[c]['ruler'] != 'NOT_RUN']
    r2s = {c: conds[c]['rules']['2_DOPC_neg_crux'] for c in ran}
    F1 = bool(ran) and all(v == 'FAIL' for v in r2s.values())
    F2 = bool(ran) and all(conds[c]['systems']['DOPE']['hii'] and conds[c]['systems']['DOPE']['hii']['state'] == 'EVALUABLE'
                           and conds[c]['systems']['DOPE']['hii']['n_LOST'] >= 2 for c in ran)
    return runs, dict(conditions=conds, main_condition=main, conditions_run=ran, crux_rule2=r2s, F1_crux_fail=F1, F2_pos_ruler_fail=F2,
                      F3_overdriven=[c for c in ran if conds[c].get('F3_overdriven')],
                      branch=('B1: 350 K H_II/片层续跑到 2 µs (K 10-30 11:30 定; 共存起点补丁另立预注册)' if F1 else
                              ('主条件 %s 进第 2-3 晚续跑 (1.2 -> 2 µs) 做时间稳健性' % main if main else '无 PASS 条件且非 F1: 按 PLAN §6 由 K 定 (不自动执行)')))

RUN_COLS = ['build', 'prim', 'w', 'T', 'arm', 'seed', 'start', 'prod', 'status', 'sub', 'f_HII', 'T_obs_ns', 'n_frames', 'n_window', 't_loss_ns',
            'n_tube_t0', 'n_tube_final', 'C_max_med_LAM', 't_event_ns', 't_merge_ns', 'window_counts']
def fmt(v): return '-' if v is None or v == '' else (json.dumps(v, ensure_ascii=False) if isinstance(v, (dict, list)) else str(v))

def judge(a):
    st = list(csv.DictReader(open(os.path.join(a.out, 'runs_status.tsv')), delimiter='\t'))
    d1 = list(csv.DictReader(open(a.d1v2_lam), delimiter='\t'))
    hz = []
    for x in a.horizons.split(','):
        hz.append(None if x.strip() == 'max' else float(x))
    per = {}
    for h in hz: per['max' if h is None else '%g' % h] = judge_all(st, d1, h)
    runs, final = per['max'] if 'max' in per else per[list(per)[-1]]
    retract = []
    for k, (_, v) in per.items():
        if k == 'max': continue
        for c in PRIORITY:
            if v['conditions'][c]['ruler'] == 'PASS' and final['conditions'][c]['ruler'] != 'PASS':
                retract.append('撤回: 条件 %s 在 %s ns 判定窗 PASS, 在最长时长判定窗为 %s' % (c, k, final['conditions'][c]['ruler']))
    if a.compare:
        old = json.load(open(a.compare))
        for c in PRIORITY:
            o = old.get('final', {}).get('conditions', {}).get(c, {}).get('ruler')
            if o == 'PASS' and final['conditions'][c]['ruler'] != 'PASS':
                retract.append('撤回: 条件 %s 在旧 VERDICT (%s) 为 PASS, 现为 %s' % (c, a.compare, final['conditions'][c]['ruler']))
    self_sha = hashlib.sha256(open(os.path.abspath(__file__), 'rb').read()).hexdigest()
    V = dict(script='verdict_R4_3day.py', script_sha256=self_sha, prereg='PREREG_R4_3day.md', d1v2_lam=os.path.abspath(a.d1v2_lam), d1v2_lam_sha256=sha256(a.d1v2_lam),
             constants=dict(N_PER=N_PER, WIN_NS=WIN_NS, WIN_MIN_FRAMES=WIN_MIN_FRAMES, T_EVAL_MIN_NS=T_EVAL_MIN_NS, RETAIN_MIN=RETAIN_MIN, LOST_MAX=LOST_MAX,
                            LAM_RETURN_CMAX=LAM_RETURN_CMAX, CZ_MAX=CZ_MAX, EVENT_PERSIST_NS=EVENT_PERSIST_NS, MERGE_PERSIST_NS=MERGE_PERSIST_NS, DELTA_SEP=DELTA_SEP),
             horizons=list(per), retractions=retract, final=final, by_horizon={k: v[1] for k, v in per.items() if k != 'max'})
    json.dump(V, open(os.path.join(a.out, 'VERDICT.json'), 'w'), indent=1, ensure_ascii=False)
    with open(os.path.join(a.out, 'runs.tsv'), 'w') as f:
        f.write('\t'.join(RUN_COLS) + '\n')
        for r in runs: f.write('\t'.join(fmt(r.get(c)) for c in RUN_COLS) + '\n')
    with open(os.path.join(a.out, 'cells.tsv'), 'w') as f:
        f.write('cond\tprim\tarm\tstate\tn_eval\tn_RETAIN\tn_LOST\tn_PARTIAL\tn_event\tn_merge\tphase_class\truns\tnotes\n')
        for c in PRIORITY:
            for p in PRIMS:
                s = final['conditions'][c]['systems'][p]
                for arm in ('hii', 'lam'):
                    x = s[arm]
                    if x is None: continue
                    f.write('\t'.join([c, p, arm, x['state'], str(x['n_eval']), fmt(x.get('n_RETAIN')), fmt(x.get('n_LOST')), fmt(x.get('n_PARTIAL')),
                                       fmt(x.get('n_event')), fmt(x.get('n_merge')), s['phase_class'], ','.join(x['runs']), '; '.join(x['notes'])]) + '\n')
    L = ['# VERDICT R4-3day (verdict_R4_3day.py sha256 %s)' % self_sha[:16], '', '判定窗 = 各 run 最长时长的最后 100 ns; horizons = %s' % ', '.join(per), '']
    for c in PRIORITY:
        x = final['conditions'][c]; L.append('## %s (%s %s): RULER = %s' % (c, x['T'], x['w'], x['ruler']))
        if x['ruler'] == 'NOT_RUN': L.append(''); continue
        L.append('- 规则: ' + ', '.join('%s=%s' % kv for kv in x['rules'].items()))
        for d in x['determined_fail_notes']: L.append('- 说明: ' + d)
        for p in PRIMS:
            s = x['systems'][p]; h = s['hii']; l = s['lam']
            hs = ('%s n=%d RETAIN %d / LOST %d / PARTIAL %d' % (h['state'], h['n_eval'], h['n_RETAIN'], h['n_LOST'], h['n_PARTIAL'])) if h else '-'
            ls = ('%s(%s) n=%d 事件 %d, ncl==1 %d' % (l['state'], l['source'], l['n_eval'], l['n_event'], l['n_merge'])) if l else '-'
            L.append('- %s: H_II %s | 片层 %s | 相类 %s%s' % (p, hs, ls, s['phase_class'], (' 像 ' + '/'.join(s['like'])) if s.get('like') else ''))
        L.append('- Δ(MC3−MC3H RETAIN): %s' % json.dumps(x['delta'], ensure_ascii=False))
        if x.get('MC3_note'): L.append('- ' + x['MC3_note'])
        L.append('')
    L += ['## 汇总', '- 主条件: %s' % final['main_condition'], '- 命门 (规则 2) 各条件: %s' % json.dumps(final['crux_rule2'], ensure_ascii=False),
          '- F1 命门失败: %s; F2 阳性尺失败: %s; F3 驱动过强: %s' % (final['F1_crux_fail'], final['F2_pos_ruler_fail'], final['F3_overdriven']),
          '- 分支: ' + final['branch']] + ['- ' + r for r in retract] + ([] if retract else ['- 撤回: 无'])
    open(os.path.join(a.out, 'VERDICT.md'), 'w').write('\n'.join(L) + '\n'); print('\n'.join(L))

if __name__ == '__main__':
    ap = argparse.ArgumentParser(); sp = ap.add_subparsers(dest='cmd', required=True)
    c = sp.add_parser('collect'); c.add_argument('runs', nargs='+'); c.add_argument('--inputs', required=True); c.add_argument('--out', required=True); c.add_argument('--jobs', type=int, default=4)
    j = sp.add_parser('judge'); j.add_argument('out'); j.add_argument('--d1v2-lam', required=True); j.add_argument('--compare'); j.add_argument('--horizons', default='400,max')
