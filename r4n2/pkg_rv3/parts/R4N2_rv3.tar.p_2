; 来源/规则见 make_mdps.py 文件头; 非键项逐字同 R2a/官方 martini_v3.0_prod.mdp
integrator               = md
dt                       = 0.015
nsteps                   = 1000000
nstxout-compressed       = 100000
compressed-x-precision   = 100
nstenergy                = 5000
nstlog                   = 25000
cutoff-scheme            = Verlet
nstlist                  = 20
rlist                    = 1.35
verlet-buffer-tolerance  = -1
pbc                      = xyz
coulombtype              = reaction-field
rcoulomb                 = 1.1
epsilon_r                = 15
epsilon_rf               = 0
vdw_type                 = cutoff
vdw-modifier             = Potential-shift-verlet
rvdw                     = 1.1
nsttcouple               = 2
nstpcouple               = 2
tcoupl                   = v-rescale
tc-grps                  = Solvent Rest
tau_t                    = 1.0 1.0
ref_t                    = @TEMP@ @TEMP@
gen_vel                  = yes
gen_temp                 = @TEMP@
gen_seed                 = @SEED@
pcoupl                   = c-rescale
pcoupltype               = semiisotropic
tau_p                    = 1.0
ref_p                    = 1.0 1.0
compressibility          = 3e-4 3e-4
refcoord_scaling         = all
comm-mode                = Linear
nstcomm                  = 100
