# mock gmx (只给 tests/test_ext_n2.sh 用; MODE=local GMX_LOCAL=<此文件>). "tpr" = 文本文件, 行 nsteps = N.
#  convert-tpr -s a -nsteps N -o b : 复制 a 并改 nsteps (MOCK_CONVERT_FAIL=1 -> rc 1; MOCK_CONVERT_BAD=1 -> 写 N+1)
#  dump -s a : 打印 "   nsteps                         = N"
#  mdrun -deffnm f [-s tpr] [-cpi cpt] -noappend ... : 读 tpr nsteps, cpt 内 step; 写 f.partNNNN.log (Step/Time 块 + Finished mdrun + Performance), f.cpt (step=N 或 MOCK_STOP_AT)
#  grompp/trjconv: 只给 CHECK=1 box 冒烟 (写空 tpr / 复制帧)
#  --version : GROMACS version 2026.3-mock
a=("$@"); get(){ local k=$1 i; for ((i=0;i<${#a[@]};i++)); do [ "${a[$i]}" = "$k" ] && { echo "${a[$((i+1))]}"; return; }; done; }
case "$1" in
  --version) echo ":-) GROMACS - gmx, 2026.3-mock"; echo "GROMACS version:    2026.3-mock";;
  convert-tpr) [ "${MOCK_CONVERT_FAIL:-0}" = 1 ] && { echo "Fatal error: mock"; exit 1; }; n=$(get -nsteps); [ "${MOCK_CONVERT_BAD:-0}" = 1 ] && n=$((n+1))
    grep -v '^nsteps' "$(get -s)" > "$(get -o)"; echo "nsteps = $n" >> "$(get -o)"; echo "convert ok";;
  dump) awk '$1=="nsteps"{printf "   nsteps                         = %s\n", $3}' "$(get -s)";;
  mdrun) f=$(get -deffnm); s=$(get -s); s=${s:-$f.tpr}; c=$(get -cpi); n=$(awk '$1=="nsteps"{print $3}' $s); st=0
    [ -n "$c" ] && st=$(awk '$1=="step"{print $2}' $c); part=$(( $( [ -n "$c" ] && awk '$1=="part"{print $2}' $c || echo 0) + 1 ))
    end=${MOCK_STOP_AT:-$n}; pn=$(printf 'part%04d' $part); lg=$f.$pn.log
    { echo "mock mdrun $*"; echo "src=$s cpi=$c start_step=$st"; echo "           Step           Time"; echo "       $end    $(awk -v e=$end 'BEGIN{print e*0.02}')"; echo ""; echo "Performance:    15000.0  1.6"; [ "${MOCK_MD_RC:-0}" = 0 ] && echo "Finished mdrun on rank 0"; } > $lg
    printf 'step %s\npart %s\n' $end $part > $f.cpt; echo x > $f.$pn.xtc; echo x > $f.$pn.edr; echo x > $f.$pn.gro; exit ${MOCK_MD_RC:-0};;
  grompp) printf 'nsteps = 1\nmock grompp of %s\n' "$(get -f)" > "$(get -o)"; echo "mock grompp ok";;   # CHECK 两槽 grompp 自检用 (box 冒烟)
  trjconv) cat > /dev/null; o=$(get -o); cp "$(get -f)" "${o%.gro}0.gro";;
  *) echo "mock gmx: 不支持 $1"; exit 2;;
esac
