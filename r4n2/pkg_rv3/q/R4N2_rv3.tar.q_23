# mock nvidia-cuda-mps-control (只在 tests/test_mps_n2.sh 里用, PATH 前置). 行为:
#  -d : 若 $MOCK_DIR/start_fail 存在 -> rc 1; 否则 mkfifo $CUDA_MPS_PIPE_DIRECTORY/control, 后台起一个 argv0=nvidia-cuda-mps-control 的 sleep (继承 CUDA_MPS_PIPE_DIRECTORY), 若 $MOCK_DIR/start_dead 存在则不起进程
#  stdin get_server_list : 有 pipe 匹配的假守护且无 $MOCK_DIR/gsl_fail -> rc 0
#  stdin quit : 杀掉 pipe 匹配的假守护 (只杀本 mock 起的 sleep), 记 $MOCK_DIR/quit.log
P=$CUDA_MPS_PIPE_DIRECTORY
mine(){ for p in $(pgrep -f '^nvidia-cuda-mps-control 3600'); do e=$(tr '\0' '\n' < /proc/$p/environ 2>/dev/null | sed -n 's/^CUDA_MPS_PIPE_DIRECTORY=//p'); [ "$e" = "$P" ] && echo $p; done; }
if [ "${1:-}" = -d ]; then [ -e $MOCK_DIR/start_fail ] && exit 1; mkfifo $P/control 2>/dev/null
  [ -e $MOCK_DIR/start_dead ] || ( exec -a nvidia-cuda-mps-control sleep 3600 ) >/dev/null 2>&1 < /dev/null & 
  echo "start $P" >> $MOCK_DIR/start.log; exit 0; fi
read -r cmd
case "$cmd" in
  get_server_list) [ -e $MOCK_DIR/gsl_fail ] && exit 1; [ -n "$(mine)" ] && exit 0; exit 1;;
  quit) echo "quit $P" >> $MOCK_DIR/quit.log; for p in $(mine); do kill $p; done; exit 0;;
  *) exit 2;; esac
␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀R4N2/tests/test_ext_n2.sh␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀0000755␀0000000␀0000000␀00000014767␀15271232653␀012415␀ 0␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀ustar  ␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀#!/bin/bash
# test_ext_n2.sh [包目录] -- box 上用 mock gmx 测 [R4N2] 续跑 (ext_src_check / ext_src / run_ext / ext_lower_busy / need_h_ext). 只写 /tmp, 不碰源树.
# 假第 1 晚树: $T/prior/R4N1_run_k03_X/builds/<b>/prod/attempt_001 {prod.tpr prod.cpt prod.log STATUS SHA256_out.txt}
# E1 正常: 源 sha 对 -> convert (dump 复核 nsteps=60000000) -> mdrun -s ext.tpr -cpi src.cpt -noappend -> DONE, ext.part0002.log, 源目录未被改
# E2 源 cpt 被改 (sha 不符) -> EXT_NO_SRC (不从头跑)   E3 无源 -> EXT_NO_SRC   E4 两个先前 run 都有 DONE -> EXT_SRC_AMBIG
# E5 源 laststep < 20M -> EXT_NO_SRC   E6 截断 -> TRUNC; 再调 -> 新 attempt 用首个 ext.tpr + 最新 ext.cpt 续 -> DONE
# E7 低一段未 DONE -> EXT_WAIT_LOWER   E8 1200 DONE 后 2000 段以本 OUT ext1200 为源 (nsteps=100000000)
# E9 convert 写错 nsteps -> EXT_TPR_BAD + HALT   E10 非 hii 臂 -> REFUSE_EXT_ARM   E11 need_h_ext 数值 (800 ns @ 珠数缩放)
# (不 set -u: run_R4N2.sh 本身不用 set -u, lib 依赖未设变量为空)
H=${1:-$(cd "$(dirname "$0")/.." && pwd)}; H=$(cd $H && pwd); T=$(mktemp -d /tmp/R4N2_ext_test_XXXXXX)
fails=0; ok(){ echo "PASS $*"; }; bad(){ echo "FAIL $*"; fails=$((fails+1)); }
mkprior(){ local run=$1 b=$2 ls=${3:-20000000} d; d=$T/prior/$run/builds/$b/prod/attempt_001; mkdir -p $d
  printf 'nsteps = 20000000\nbuild %s\n' $b > $d/prod.tpr; printf 'step %s\npart 1\n' $ls > $d/prod.cpt
  printf '           Step           Time\n       %s    0\nFinished mdrun\n' $ls > $d/prod.log; echo "DONE rc=0 laststep=$ls/20000000 nan=0" > $d/STATUS
  ( cd $d && sha256sum prod.tpr prod.log prod.cpt > SHA256_out.txt ); }
B1=R4N1_DOPC_h050_T350_hii_s1 B2=R4N1_DOPC_h050_T350_hii_s4 B3=R4N1_DOPC_h050_T350_hii_s3 B4=R4N1_MC3H_h050_T350_hii_s1 B5=R4N1_DOPE_h050_T350_hii_s1 B6=R4N1_MC3H_h050_T350_hii_s2
mkprior R4N1_run_k03_X $B1; mkprior R4N1_run_k03_X $B2; echo tampered >> $T/prior/R4N1_run_k03_X/builds/$B2/prod/attempt_001/prod.cpt
mkprior R4N1_run_k03_X $B4; mkprior R4N1_run_k03_Y $B4; mkprior R4N1_run_k03_X $B5 19000000; mkprior R4N1_run_k03_X $B6
SRCSHA0=$(cd $T/prior && find . -type f | sort | xargs sha256sum | sha256sum)
(
  HERE=$H MACHINE=k03 MODE=local GMX_LOCAL=$H/tests/mock/gmx X_MPS=off WAIT_MAIN=none DEADLINE="$(date -d '+10 hour' '+%F %T %z')" EXT_SRC_RUNS="$T/prior/R4N1_run_k03_*" J=$T/J PERF_OVERRIDE_FILE=$T/none
  . $H/lib_R4N2.sh >/dev/null 2>&1 || true
  OUT=$T/out; mkdir -p $OUT/slots $OUT/ledger; SLOT_TAG=k03_A ORCH_PID=$$ MD_RC=0
  st(){ last_state $OUT/builds/$1/ext$2; }
  run_ext $B1 1200 main 0 main >/dev/null 2>&1; d=$OUT/builds/$B1/ext1200/attempt_001
  [ "$(st $B1 1200)" = DONE ] && [ -s $d/ext.part0002.log ] && grep -q 'nsteps(dump)=60000000 期望 60000000' $d/EXT_SRC.txt && grep -q -- '-s ext.tpr -cpi src.cpt -noappend' $d/mdrun_cmd.txt && grep -q 'src_kind=prior_prod' $d/EXT_SRC.txt && grep -q ext.cpt $d/SHA256_out.txt \
    && ok "E1 400->1200: 源 sha 对, convert nsteps=60M (dump 复核), -s ext.tpr -cpi src.cpt -noappend, DONE" || bad "E1 st=$(st $B1 1200) $(cat $d/STATUS 2>/dev/null)"
  run_ext $B2 1200 main 0 main >/dev/null 2>&1; [ "$(st $B2 1200)" = EXT_NO_SRC ] && grep -q 'sha' $OUT/builds/$B2/ext1200/attempt_001/STATUS && [ ! -e $OUT/builds/$B2/ext1200/attempt_001/mdrun_cmd.txt ] && ok "E2 源 cpt 被改 -> EXT_NO_SRC (不跑)" || bad "E2 $(cat $OUT/builds/$B2/ext1200/attempt_001/STATUS)"
  run_ext $B3 1200 main 0 main >/dev/null 2>&1; [ "$(st $B3 1200)" = EXT_NO_SRC ] && ok "E3 无源 -> EXT_NO_SRC" || bad "E3 $(st $B3 1200)"
  run_ext $B4 1200 main 0 main >/dev/null 2>&1; [ "$(st $B4 1200)" = EXT_SRC_AMBIG ] && ok "E4 两个先前 run 都 DONE -> EXT_SRC_AMBIG" || bad "E4 $(st $B4 1200)"
  run_ext $B5 1200 main 0 main >/dev/null 2>&1; [ "$(st $B5 1200)" = EXT_NO_SRC ] && grep -q laststep $OUT/builds/$B5/ext1200/attempt_001/STATUS && ok "E5 源 laststep 19M<20M -> EXT_NO_SRC" || bad "E5 $(cat $OUT/builds/$B5/ext1200/attempt_001/STATUS)"
  MOCK_STOP_AT=40000000 run_ext $B6 1200 main 0 main >/dev/null 2>&1; s1=$(st $B6 1200)
  export -n MOCK_STOP_AT; run_ext $B6 1200 main 0 main >/dev/null 2>&1; d=$OUT/builds/$B6/ext1200/attempt_002
  [ "$s1" = TRUNC ] && [ "$(st $B6 1200)" = DONE ] && grep -q "attempt_001/ext.tpr -cpi .*attempt_001/ext.cpt -noappend" $d/mdrun_cmd.txt && [ -s $d/ext.part0003.log ] && ok "E6 截断 TRUNC -> 新 attempt 续 (首个 ext.tpr + 最新 ext.cpt) -> DONE (part0003)" || bad "E6 s1=$s1 s2=$(st $B6 1200)"
  mkdir -p $OUT/builds/$B5/ext2000; run_ext $B5 2000 fill 0 supp >/dev/null 2>&1; [ ! -d $OUT/builds/$B5/ext2000/attempt_001 ] && grep -q "EXT_WAIT_LOWER" $OUT/ALL_RECORDS.tsv && ok "E7 低一段 (ext1200) 未 DONE -> EXT_WAIT_LOWER, 不建 attempt" || bad "E7"
  run_ext $B1 2000 fill 0 supp >/dev/null 2>&1; d=$OUT/builds/$B1/ext2000/attempt_001
  [ "$(st $B1 2000)" = DONE ] && grep -q 'src_kind=ext1200' $d/EXT_SRC.txt && grep -q 'nsteps(dump)=100000000' $d/EXT_SRC.txt && ok "E8 1200 DONE -> 2000 以本 OUT ext1200 为源, nsteps=100M" || bad "E8 $(st $B1 2000) $(cat $d/STATUS 2>/dev/null)"
  echo "nsteps(ext_from_ns $B1 2000)=$(ext_from_ns $B1 2000) need_h_ext($B4 1200)=$(need_h_ext $B4 1200) perf_eff=$(perf_eff) atoms=$(exp_of $B4 EXP_ATOMS)"
  awk -v n=$(need_h_ext $B4 1200) -v p=$(perf_eff) -v a=$(exp_of $B4 EXP_ATOMS) -v r=$PERF_REF_BEADS -v o=$OVH_H 'BEGIN{e=800/(p*r/a)*24+o; exit !( (n-e)^2<0.01 )}' && ok "E11 need_h_ext = 800 ns/(perf*珠数缩放)*24+OVH" || bad "E11"
  exit $fails ) ; rc=$?
# E9/E10 单独 OUT
(
  HERE=$H MACHINE=k03 MODE=local GMX_LOCAL=$H/tests/mock/gmx X_MPS=off WAIT_MAIN=none DEADLINE="$(date -d '+10 hour' '+%F %T %z')" EXT_SRC_RUNS="$T/prior/R4N1_run_k03_X" J=$T/J PERF_OVERRIDE_FILE=$T/none
  . $H/lib_R4N2.sh >/dev/null 2>&1 || true
  OUT=$T/out2; mkdir -p $OUT/slots $OUT/ledger; SLOT_TAG=k03_B ORCH_PID=$$; f=0
  MOCK_CONVERT_BAD=1 run_ext R4N1_DOPC_h050_T350_hii_s1 1200 main 0 main >/dev/null 2>&1
  [ "$(last_state $OUT/builds/R4N1_DOPC_h050_T350_hii_s1/ext1200)" = EXT_TPR_BAD ] && [ -f $OUT/HALT ] && echo "PASS E9 convert nsteps 不符 -> EXT_TPR_BAD + HALT" || { echo "FAIL E9"; f=1; }
  run_ext R4N1_DOPE_h100_T350_lam_s2 1200 main 0 main >/dev/null 2>&1; [ $? = 9 ] && grep -q REFUSE_EXT_ARM $OUT/ALL_RECORDS.tsv && echo "PASS E10 lam 臂 ext -> REFUSE_EXT_ARM" || { echo "FAIL E10"; f=1; }
  exit $f ); rc=$((rc+$?))
SRCSHA1=$(cd $T/prior && find . -type f | sort | xargs sha256sum | sha256sum); [ "$SRCSHA0" = "$SRCSHA1" ] && echo "PASS E0 先前 run 树逐字节未变 (只读)" || { echo "FAIL E0 源树被改"; rc=$((rc+1)); }
echo "== test_ext_n2: $([ $rc = 0 ] && echo ALL PASS || echo "$rc FAIL") (tmp=$T)"; exit $rc
␀␀␀␀␀␀␀␀␀R4N2/tests/test_mps_n2.sh␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀0000755␀0000000␀0000000␀00000011115␀15271232653␀012374␀ 0␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀ustar  ␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀#!/bin/bash
# test_mps_n2.sh -- box 上用 mock nvidia-cuda-mps-control 测 [R4N2] MPS 修复 (x_mps_pick / x_mps_alive / x_mps_stop). 只写 /tmp; 只杀 mock 自己起的 sleep.
# 场景 (X_MPS_MAX_START=2): T1 首次起 own_started; T2 env 在且活 -> own (不重起); T3 守护被杀 (=10-30 事故) -> env 改名 dead_ + own_restarted;
#       T4 守护在但 get_server_list 不通 (挂死) -> 对自己 pipe 发 quit, 超预算 none_dead_budget; T5 stop -> env 改名 stopped_, quit 已发, 再 pick 不会 own (APPEND_TO 不复用)
#       T6 -d 失败 -> none_start_fail; T7 起后验活不过 (进程没起) -> none_start_fail + 对该 pipe 发 quit; T8 机上有别的 MPS 进程 -> none_mps_present
set -u
H=$(cd "$(dirname "$0")/.." && pwd); T=$(mktemp -d /tmp/R4N2_mps_test_XXXXXX); export MOCK_DIR=$T/mock; mkdir -p $MOCK_DIR
export PATH=$H/tests/mock:$PATH HOME_SAVE=$HOME
fails=0; ok(){ echo "PASS $*"; }; bad(){ echo "FAIL $*"; fails=$((fails+1)); }
killmock(){ for p in $(pgrep -f '^nvidia-cuda-mps-control 3600'); do e=$(tr '\0' '\n' < /proc/$p/environ 2>/dev/null | sed -n 's/^CUDA_MPS_PIPE_DIRECTORY=//p'); case "$e" in $T/*) kill $p;; esac; done; }
trap killmock EXIT
newout(){ OUT=$T/out_$1; mkdir -p $OUT/slots $OUT/ledger; }
(  # 子 shell 里 source lib (MODE=local + X_MPS_TEST=1 才走 MPS 逻辑)
  MACHINE=k03 MODE=local X_MPS_TEST=1 X_MPS=auto X_MPS_MAX_START=2 WAIT_MAIN=none X_MPS_ROOT_BASE=$T/roots X_MPS_START_WAIT_S=1 X_MPS_STOP_WAIT_S=1 HERE=$H
  . $H/lib_R4N2.sh >/dev/null 2>&1 || true
  SLOT_TAG=k03_A
  newout 1
  XB=b1; x_mps_pick; [ "$X_MPS_NOTE" = own_started ] && [ -f $OUT/slots/x_mps.env ] && [ -n "$MPSARGS" ] && ok "T1 own_started ($X_MPS_WHY)" || bad "T1 got $X_MPS_NOTE $X_MPS_WHY"
  P1=$(sed -n 's/^MPSPIPE=//p' $OUT/slots/x_mps.env)
  XB=b2; x_mps_pick; [ "$X_MPS_NOTE" = own ] && [ "$(wc -l < $MOCK_DIR/start.log)" = 1 ] && ok "T2 env+活 -> own, 不重起" || bad "T2 got $X_MPS_NOTE"
  for p in $(pgrep -f '^nvidia-cuda-mps-control 3600'); do kill $p; done; sleep 0.3   # 模拟守护被前一段收尾 quit 掉
  XB=b3; x_mps_pick; P2=$(sed -n 's/^MPSPIPE=//p' $OUT/slots/x_mps.env 2>/dev/null)
  [ "$X_MPS_NOTE" = own_restarted ] && ls $OUT/slots/x_mps.env.dead_* >/dev/null 2>&1 && [ "$P2" != "$P1" ] && grep -q 'own_restarted' $OUT/slots/x_mps_events.log && ok "T3 守护死 -> 旧 env 改名 dead_, 新 pipe own_restarted ($P2)" || bad "T3 got $X_MPS_NOTE P1=$P1 P2=$P2"
  touch $MOCK_DIR/gsl_fail; XB=b4; x_mps_pick; [ "$X_MPS_NOTE" = none_dead_budget ] && [ -z "$MPSARGS" ] && [ ! -f $OUT/slots/x_mps.env ] && grep -q "quit $P2" $MOCK_DIR/quit.log && grep -q dead_own_quit $OUT/slots/x_mps_events.log && ok "T4 守护在但 pipe 不通 (挂死) -> 对自己 pipe 发 quit, 已起 2 次 (=上限) -> none_dead_budget, MPSARGS 空" || bad "T4 got $X_MPS_NOTE args=$MPSARGS"
  rm -f $MOCK_DIR/gsl_fail; killmock; sleep 0.3
  newout 5; XB=b5; x_mps_pick; [ "$X_MPS_NOTE" = own_started ] || bad "T5 pre got $X_MPS_NOTE"; P5=$(sed -n 's/^MPSPIPE=//p' $OUT/slots/x_mps.env)
  x_mps_stop >/dev/null; [ ! -f $OUT/slots/x_mps.env ] && ls $OUT/slots/x_mps.env.stopped_* >/dev/null 2>&1 && grep -q "quit $P5" $MOCK_DIR/quit.log && ok "T5 stop -> quit 已发, env 改名 stopped_" || bad "T5 stop"
  XB=b5b; x_mps_pick; [ "$X_MPS_NOTE" = own_restarted ] && [ "$(sed -n 's/^MPSPIPE=//p' $OUT/slots/x_mps.env)" != "$P5" ] && ok "T5b stop 后再 pick (APPEND_TO 情形) 不复用旧 pipe, 起新的" || bad "T5b got $X_MPS_NOTE"
  x_mps_stop >/dev/null; killmock; sleep 0.3
  newout 6; touch $MOCK_DIR/start_fail; XB=b6; x_mps_pick; rm -f $MOCK_DIR/start_fail; [ "$X_MPS_NOTE" = none_start_fail ] && [ -z "$MPSARGS" ] && ok "T6 -d 失败 -> none_start_fail" || bad "T6 got $X_MPS_NOTE"
  sleep 1.1; newout 7; touch $MOCK_DIR/start_dead; XB=b7; : > $MOCK_DIR/quit.log; x_mps_pick; rm -f $MOCK_DIR/start_dead
  [ "$X_MPS_NOTE" = none_start_fail ] && [ -s $MOCK_DIR/quit.log ] && [ ! -f $OUT/slots/x_mps.env ] && ok "T7 起后验活不过 -> none_start_fail, 已对该 pipe 发 quit, 不写 env" || bad "T7 got $X_MPS_NOTE"
  newout 8; ( exec -a nvidia-cuda-mps-server sleep 30 ) & SP=$!; sleep 0.3; XB=b8; x_mps_pick; kill $SP 2>/dev/null
  [ "$X_MPS_NOTE" = none_mps_present ] && ls $OUT/slots/x_mps_residue_* >/dev/null 2>&1 && ok "T8 机上有别的 MPS 进程 -> none_mps_present + 认人文件 (不 quit/不 kill)" || bad "T8 got $X_MPS_NOTE"
  newout 9; X_MPS=off; XB=b9; x_mps_pick; [ "$X_MPS_NOTE" = off ] && ok "T9 X_MPS=off" || bad "T9"
  echo "events log 示例:"; cat $T/out_1/slots/x_mps_events.log
  exit $fails ); rc=$?
killmock; echo "== test_mps_n2: $([ $rc = 0 ] && echo ALL PASS || echo "$rc FAIL") (tmp=$T)"; exit $rc
